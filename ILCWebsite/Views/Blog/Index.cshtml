@model List<ILC.BL.Models.Admin.HomeSection.Blog.BlogHomeVM>
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Index";
}
<style>
    .blog {
        position: relative;
        width: 100%;
        height: 220px;
        background-size: cover;
        box-shadow: 3px 3px 20px rgba(0,0,0,0.5);
        margin: 1em 0;
        overflow: hidden;
        border-radius: 0.7em;
    }

        .blog * {
            position: relative;
            z-index: 2;
        }

        .blog:hover .color-overlay {
            background: rgba(0, 0, 0, 0.2);
        }

    .color-overlay {
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        position: absolute;
        transition: 0.7s background;
        /* background: rgba(0, 0, 0, 0.1); */
        z-index: 1;
        border-radius: 0.7em;
    }
     
    .footer {
        display: inline-block;
        position: absolute;
        bottom: 0;
        width: 100%;
        height: 15em;
        background: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.9));
        border-radius: 0 0 0.7em 0.7em;
    }

        .footer > .icon-holder {
            position: absolute;
            bottom: 20px;
            text-align:center;
            height: 3em;
            width: 100%;
            display: inline-block; 
            padding: 0 2em;
        }

    .icon-holder i {
        color: #D0BC57;  
    }

    .icon-holder span{
        color: #aCcff0;
    }

    space {
        display: inline-block;
        width: 0.6em;
        height: 1em;
    }
</style>
<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs">
                    <p class="breadcrumbs-title" data-i18n="Blogs"></p>
                    <ul class="breadcrumbs-list">
                        <li><a asp-controller="Home" asp-action="index" data-i18n="Home"></a></li>
                        <li data-i18n="Blogs"></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<section id="page-content" class="page-wrapper">


    <!-- FEATURED FLAT AREA START -->
    <div class="featured-flat-area pt-40 pb-30">
        <div class="container">
            <div class="featured-flat">
                <div class="row">
                    <!-- service-item -->
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                            <a href="/Blog/Details?id=@item.Id">
                                <div class="blog" style="background-image: url('@item.ImagePath'); background-size: cover; background-position: center; background-repeat: no-repeat;"> 
                                    <div class="footer">
                                        <div class="icon-holder">
                                            <span class="en" href="/Blog/Details?id=@item.Id" style="font-size:1em">@Truncate(item.TitleEn, 55)</span>
                                            <span class="ar" href="/Blog/Details?id=@item.Id">@Truncate(item.TitleAr,55)</span>
                                        </div>
                                    </div>
                                    <div class="color-overlay"></div>
                                </div>
                            </a>
                        </div>
                        @*  <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6 col-xs-12 ">
                    <article class="blog-item bg-gray">
                    <div class="blog-image">
                    <a href="/Blog/Details?id=@item.Id"><img src="@item.ImagePath" alt="" style="height:180px;object-fit:cover"></a>
                    </div>
                    <div class="blog-info" style="height:130px">
                    <div class="post-title-time">
                    <a href="/Blog/Details?id=@item.Id"><p class="en" style="color:#000">@Truncate(item.TitleEn, 100)</p></a>
                    <a href="/Blog/Details?id=@item.Id"><p class="ar rtl" style="color:#000"> @Truncate(item.TitleAr, 100)</p></a>
                    <p class="en">@item.CreationDate.GetValueOrDefault().ToString("dd-MM-yyyy")</p>
                    <p class="ar rtl">@item.CreationDate.GetValueOrDefault().ToString("dd-MM-yyyy")</p>
                    </div>
                    </div>
                    </article>
                    </div> *@
                    }
                </div>
            </div>
        </div>
    </div>


</section>








@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}