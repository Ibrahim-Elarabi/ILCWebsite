    .blogCard {
        position: relative;
        background-color:#fff;  /* #FEEFDE; */
        border-radius: 8px;
        overflow: hidden;
        padding-bottom: 10px;
         /* box-shadow: 1px 2px 8px rgba(100, 100, 100, 0.1); */
         box-shadow: 0 18px 42px 0 rgba(28, 30, 35, 0.15)
    }

    .image-wrapper {
        width: auto;
        height: 200px;
        overflow: hidden;
    }

    img {
        max-width: 100%;
        height: auto;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
    }

    img:hover {
        -webkit-transform: scale3d(1.2, 1.2, 1);
        transform: scale3d(1.1, 1.1, 1);
        transition: all 1s linear;
    }

    .text-box-wrapper {
        padding: 20px 20px
    }

    .text-box {
        height: 130px;
        overflow: hidden;
        display: block;
        width: 100%; 
        line-height: 25px;
        font-size: 14px;
    }

    .heading {
        font-size: 16px;
        font-weight: 400;
        color:#222;
    } 
    .moreBtn {
        display: inline-block; 
        padding: 5px 20px;
        font-family: 'Poppins';
        font-size: 12px;
        font-weight: 600;
        color: #8C5450;
        text-decoration: none;
        font-size:15px;
    }

    .moreBtn:hover {
            color: black;
            transition: linear 0.2s;
    }
</style>
<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs">
                    <p class="breadcrumbs-title" data-i18n="Blogs"></p>
                    <ul class="breadcrumbs-list">
                        <li><a asp-controller="Home" asp-action="index" data-i18n="Home"></a></li>
                        <li data-i18n="Blogs"></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<section id="page-content" class="page-wrapper">


    <!-- FEATURED FLAT AREA START -->
    <div class="featured-flat-area pt-40 pb-30">
        <div class="container">
            <div class="featured-flat">
                <div class="row">
                    <!-- service-item -->
                    @foreach (var item in Model)
                    {
                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-xs-12 mb-40 en">
                            <div class="card-wrapper" dir="ltr">
                                <div class="blogCard">
                                    <div class="image-wrapper">
                                        <a class="image-link" href="/Blog/Details?id=@item.Id"><img src='@item.ImagePath' height="200"></a>
                                    </div>
                                    <div class="text-box-wrapper">
                                        <div class="text-box">
                                            <p class="heading en">@item.TitleEn</p> 
                                            <p class="en">@item.DescriptionEn</p> 
                                        </div>
                                    </div>
                                     <div class="button-wrapper">
                                        <a class="moreBtn" href="/Blog/Details?id=@item.Id" data-i18n="more-details">
                                        </a>
                                     </div>  
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-xs-12 mb-30 ar">
                            <div class="card-wrapper" dir="rtl">
                                <div class="blogCard">
                                    <div class="image-wrapper">
                                        <a class="image-link" href="/Blog/Details?id=@item.Id"><img src='@item.ImagePath' height="200"></a>
                                    </div>
                                    <div class="text-box-wrapper">
                                        <div class="text-box">
                                            <p class="heading ar">@item.TitleAr</p>
                                            <p class="ar">@item.DescriptionAr</p>
                                        </div>
                                    </div>
                                    <div class="button-wrapper">
                                        <a class="moreBtn" href="/Blog/Details?id=@item.Id" data-i18n="more-details">
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>




                     @*    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                            <a href="/Blog/Details?id=@item.Id">
                                <div class="blog" style="background-image: url('@item.ImagePath'); background-size: cover; background-position: center; background-repeat: no-repeat;"> 
                                    <div class="footer">
