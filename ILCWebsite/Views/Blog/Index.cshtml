@model List<ILC.BL.Models.Admin.HomeSection.Blog.BlogHomeVM>
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Index";
}
<style>
    .bread-bg-1 {
        background: rgba(0, 0, 0, 0) url("images/bg/Blog.jpg") no-repeat scroll 0 0 / cover;
    }
</style>
<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs">
                    <h2 class="breadcrumbs-title" data-i18n="Blogs"></h2>
                    <ul class="breadcrumbs-list">
                        <li><a asp-controller="Home" asp-action="index" data-i18n="Home"></a></li>
                        <li data-i18n="Blogs"></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
 
<section id="page-content" class="page-wrapper">


    <!-- FEATURED FLAT AREA START --> 
    <div class="featured-flat-area pt-115 pb-60">
        <div class="container">
            <div class="featured-flat">
                <div class="row">
                    <!-- service-item -->
                    @foreach (var item in Model)
                    {
                        <div class="col-md-3 col-sm-6 col-xs-12">
                            <div class="service-item">
                                <div class="service-item-image">
                                    <a asp-controller="Blog" asp-action="Details" asp-route-id="@item.Id"><img src="./@item.ImagePath" alt="" style="height:200px;object-fit:cover"></a>
                                </div>
                                <div class="service-item-info rtl" style="height:80px;">
                                    <h5 class="en" style="font-size:16px">@Truncate(item.TitleEn, 40)</h5>
                                    <h5 class="ar" style="font-size:16px">@Truncate(item.TitleAr, 40)</h5> 
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>


</section>

@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}