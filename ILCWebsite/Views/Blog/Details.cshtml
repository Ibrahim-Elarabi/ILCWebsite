@model ILC.BL.Models.Admin.HomeSection.Blog.BlogHomeVM
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Details";
}
<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs">
                     <p class="breadcrumbs-title" data-i18n="Blogs"></p>
                    @*<p class="breadcrumbs-title en">@Model.TitleEn</p>
                    <p class="breadcrumbs-title ar">@Model.TitleAr</p> *@
                    <ul class="breadcrumbs-list">
                        <li><a asp-controller="Home" asp-action="index" data-i18n="Home"></a></li>
                        <li><a asp-controller="Blog" asp-action="index" data-i18n="Blogs"></a></li> 
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<section id="page-content" class="page-wrapper">
    <!-- FEATURED FLAT AREA START -->

    <div class=" pt-30 pb-30 en">
        <div class="container"> 
            <div class="row">  
                <div class="col-md-9">
                    <h4 class="en">@Model.TitleEn</h4> 
                    <img src="@Model.ImagePath" alt="" style="margin:20px 0px;max-height:400px">
                </div>
                <div class="col-md-10 col-sm-12 col-xs-12">
                    <p class="en" style="line-height: 1.8;font-size:17px;">@Model.SubTitleEn</p> 
                    <p class="en" style="line-height: 1.8;font-size:17px;">@Model.DescriptionEn</p>
                    <i class="fa fa-calendar" style="color: #333;"></i> 
                    <b>@Model.CreationDate.GetValueOrDefault().ToString("dd.MM.yyyy")</b>
                </div>
            </div> 
        </div>
    </div>

    <div class="pt-50 pb-30 ar text-right"> 
        <div class="container">
            <div class="row">  
                <div class="col-md-12"> 
                    <h4 class="ar">@Model.TitleAr</h4>
                    <img src="@Model.ImagePath" alt="" style="margin:20px 0px;max-height:400px">
                </div>
                <div class="col-md-2"></div>
                <div class="col-md-10 col-sm-12 col-xs-12"> 
                    <p class="ar" style="line-height: 1.8;font-size:17px;">@Model.SubTitleAr</p>
                    <p class="ar" style="line-height: 1.8;font-size:17px;">@Model.DescriptionAr</p>
                    <b style="line-height: 1.8;font-size:17px;">@Model.CreationDate.GetValueOrDefault().ToString("dd.MM.yyyy")</b>
                    <i class="fa fa-calendar" style="color: #333;"></i>
                </div>
            </div>
        </div>
    </div>

</section>
