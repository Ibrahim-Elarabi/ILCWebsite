@model List<ILC.BL.Models.Admin.HomeSection.Product.ProductHomeVM>

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="section-title-2 text-center">
                <h2 data-i18n="our-products"></h2>
                <p data-i18n="our-products-desc"></p>
            </div>
        </div>
         


        @foreach (var item in Model)
        {
            <div class="col-md-3 ">
                <div class="featured-flat">
                    <div class="flat-item">
                        <div class="flat-item-image">
                            <a href="/Product/Details?id=@item.Id">
                                <img src="@item.ImagePath" alt="" style="height:350px;object-fit:cover">
                            </a>
                            <div class="flat-link">
                                <a href="/Product/Details?id=@item.Id" data-i18n="more-details"></a>
                            </div> 
                            <ul class="flat-desc" style="height:70px;">
                                <li>
                                    <p class="en" style="color:#eee">@Truncate(item.TitleEn, 60)</p>
                                    <p class="ar" style="color:#eee">@Truncate(item.TitleAr, 60)</p>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
    <div class="text-center">
        <a href="/Product" class="submit-btn-1" style="margin-top:30px" data-i18n="more-details"></a>
    </div>
</div>
@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}
