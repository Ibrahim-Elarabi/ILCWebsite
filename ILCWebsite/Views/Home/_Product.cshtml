@model List<ILC.BL.Models.Admin.HomeSection.Product.ProductHomeVM>

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="section-title-2 text-center">
                <h2 data-i18n="our-products"></h2>
                <p data-i18n="our-products-desc"></p>
            </div>
        </div>
         
        @*-----------Standard-------------*@ 
         <div class="col-md-4">
            <div class="featured-flat">
                <div class="flat-item" style="">
                    <div class="flat-item-image">
                        <a href="/Product/index?type=0">
                            <img src="~/images/productstypes/elite.jpg" alt="" style="height:300px;object-fit:cover">
                        </a>
                        <div class="flat-link">
                            <a href="/Product/index?type=0" data-i18n="more-details"></a>
                        </div> 
                        <ul class="flat-desc">
                            <li style="color:#eee;font-size:17px" data-i18n="Standard">
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        @*-----------Elite-------------*@
        <div class="col-md-4">
            <div class="featured-flat">
                <div class="flat-item" style="">
                    <div class="flat-item-image">
                        <a href="/Product/index?type=0">
                            <img src="~/images/productstypes/standard.jpg" alt="" style="height:300px;object-fit:cover">
                        </a>
                        <div class="flat-link">
                            <a href="/Product/index?type=0" data-i18n="more-details"></a>
                        </div>
                        <ul class="flat-desc">
                            <li style="color:#eee;font-size:17px" data-i18n="Elite">
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        @*-----------Flage Ship-------------*@
        <div class="col-md-4">
            <div class="featured-flat">
                <div class="flat-item" style="">
                    <div class="flat-item-image">
                        <a href="/Product/index?type=0">
                            <img src="~/images/productstypes/FlagShip.jpg" alt="" style="height:300px;object-fit:cover">
                        </a>
                        <div class="flat-link">
                            <a href="/Product/index?type=0" data-i18n="more-details"></a>
                        </div>
                        <ul class="flat-desc">
                            <li style="color:#eee;font-size:17px" data-i18n="Flage-Ship">
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div> 
</div>
@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}
