@using ILC.BL.Models.Admin.HomeSection.Titles; 
@model (List<ILC.BL.Models.Admin.HomeSection.Service.ServiceHomeVM> serviceModel, TitleVM title)
 
<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="section-title-2 text-center">
                @{
                    <h2 class="en">@Model.title.TitleEn</h2>
                    <h2 class="ar">@Model.title.TitleAr</h2>
                    <p class="en">@Model.title.DescriptionEn</p>
                    <p class="ar">@Model.title.DescriptionAr</p> 
                } 
            </div>
        </div>
    </div> 
    <div class="row">
        <div class="service-carousel">
            <!-- service-item -->
            @foreach (var item in Model.serviceModel)
            {
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <div class="service-item">
                        <div class="service-item-image">
                            <a href="/Service/Details?id=@item.Id"><img src="./@item.ImagePath" alt="" style="height:250px;object-fit:cover"></a>
                        </div>
                        <div class="service-item-info rtl">
                            <h6 class="en"><a href="#">@item.TitleEn</a></h6>
                            <h6 class="ar"><a href="#">@item.TitleAr</a></h6>

                            <p class="en">@Truncate(item.DescriptionEn, 26)</p>
                            <p class="ar">@Truncate(item.DescriptionAr, 26)</p>
                        </div>
                    </div>
                </div>
            } 
        </div>
        <div class="text-center">
            <a href="/Service" class="submit-btn-1" data-i18n="more-details"></a>
        </div>
    </div>

</div>

@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}