@using ILC.BL.Models.Admin.HomeSection.Titles; 
@model (List<ILC.BL.Models.Admin.HomeSection.Agent.AgentHomeVM> agentModel, TitleVM title)
 
<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="section-title-2 text-center">
                @{
                    <h2 class="en">@Model.title.TitleEn</h2>
                    <h2 class="ar">@Model.title.TitleAr</h2>
                    <p class="en">@Model.title.DescriptionEn</p>
                    <p class="ar">@Model.title.DescriptionAr</p>
                } 
            </div>
        </div>
    </div> 
    <div class="brand-area pb-115">
        <div class="container">
            <div class="row">
                @foreach (var item in Model.agentModel)
                {
                    <div class="col-md-2">
                        <div class="brand-item img-item" title="@item.TitleEn">
                            <img class="en" src="@item.ImagePath" alt="@item.TitleEn">
                            <img class="ar" src="@item.ImagePath" alt="@item.TitleAr">
                        </div> 
                    </div>
                } 
            </div>
        </div>
    </div> 
</div>
@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}
