@model List<ILC.BL.Models.Admin.HomeSection.Agent.AgentHomeVM>

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="section-title-2 text-center">
                <h2 data-i18n="OUR_AGENTS"></h2>
                <p data-i18n="OUR_AGENTS_DESC"></p>
            </div>
        </div>
    </div> 
    <div class="brand-area pb-115">
        <div class="container">
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-2">
                        <div class="brand-item">
                            <img class="en" src="@item.ImagePath" alt="@item.TitleEn">
                            <img class="ar" src="@item.ImagePath" alt="@item.TitleAr">
                        </div>
                    </div>
                } 
            </div>
        </div>
    </div> 
</div>
@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}
