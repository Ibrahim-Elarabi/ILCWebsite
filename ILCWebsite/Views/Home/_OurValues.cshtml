@using ILC.BL.Models.Admin.HomeSection.Titles;
@using ILC.BL.Models.Admin.HomeSection.ValuesHome;
@model (List<ILC.BL.Models.Admin.HomeSection.ValuesHome.ValueHomeVM> valuesModel, TitleVM title)
<style> 
    figure.user-card {
        background: #f5f5f5; 
        padding: 20px;
        border-radius:3px; 
        text-align: center;
        border:1px solid #aaa;
        height:400px;
        overflow:unset;
        transition: all .4s ease;
        overflow-y: auto;
     }

        figure.user-card:hover {  
            border: 1px solid #888 ;  
            box-shadow: 7px 7px 25px rgba(0, 0, 0, 0.17),
                        -7px 7px 25px rgba(0, 0, 0, 0.17); 
            transform: scale(1.01);
        }

        figure.user-card:hover .profile {
                border:5px solid #000;
        }
         
    figure.user-card .profile {
        -webkit-border-radius: 50%;
        -moz-border-radius: 50%;
        border-radius: 50%;
        height: 80px;
        width:80px;
        margin-bottom: 20px;
    } 
    figure.user-card p {
        margin: 0;
        padding: 0 0 15px 0; 
        color: #555;
        line-height: 150%;
        font-size: 1.1rem;
            overflow: auto;
        }
</style>
<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="section-title-2 text-center">
                @{
                    <h2 class="en">@Model.title.TitleEn</h2>
                    <h2 class="ar">@Model.title.TitleAr</h2>
                    <p class="en">@Model.title.DescriptionEn</p>
                    <p class="ar">@Model.title.DescriptionAr</p> 
                } 
            </div>
        </div>
    </div> 
    <div class="row"> 
            @foreach (var item in Model.valuesModel)
            { 
                <div class="col-lg-4 col-md-6 col-sm-6 col-12" style="margin-bottom:20px">
                    <figure class="user-card">
                        <figcaption>
                            <img src="./@item.ImagePath" alt="Values" class="profile">
                            <h4 class="en">@item.TitleEn</h4>
                            <h4 class="ar">@item.TitleAr</h4>
                            <p class="en">@Truncate(item.DescriptionEn, 200)</p>
                            <p class="ar">@Truncate(item.DescriptionAr, 200)</p>
                        </figcaption>
                    </figure>
                </div>  
            }   
    </div>

</div>

@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}