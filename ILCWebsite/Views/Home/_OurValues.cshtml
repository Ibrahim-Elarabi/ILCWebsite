@using ILC.BL.Models.Admin.HomeSection.Titles;
@using ILC.BL.Models.Admin.HomeSection.ValuesHome;
@model (List<ILC.BL.Models.Admin.HomeSection.ValuesHome.ValueHomeVM> valuesModel, TitleVM title)
<style>
        figure.user-card {
            background: #fff;
            padding: 20px;
            border-radius: 3px;
            text-align: center; 
            height: 200px; 
            transition: all .4s ease;  
        }  
        figure.user-card .profile {
            -webkit-border-radius: 50%;
            -moz-border-radius: 50%;
            border-radius: 50%;
            height: 100px;
            width: 100px;
            margin-bottom: 20px;
        } 
        figure.user-card p {
            margin: 0;
            padding: 0 0 15px 0;
            color: #555;
            line-height: 120%;
            font-size: 1.1rem; 
        }
         
        /*animatio-------------------------------------*/ 

        #heart {
            position: relative; 
            margin: 0 auto;
        }
 
        @@keyframes heartbeat {
          0% {
            transform: scale(1);
          }
          30% {
            transform: scale(1.15);
          } 
          50% {
            transform: scale(1);
          }
          70% {
            transform: scale(1.15);
          }
          100% {
            transform: scale(1);
          }
        }

        .heart-animation.animate {
            animation: heartbeat 1s 1;
        }

        #heart:hover {
            animation: heartbeat 1s 1; 
        }

    #titleOurValuesId:hover { 
            animation: heartbeat 1s 1; 
            font-size:30px;
        } 
    #titleOurValuesId:hover {
            animation: heartbeat 1s 1; 
        }
         


/* -------------------styles.css------------------------------------ */
  
        .element {
            opacity: 0;
            transform: translateY(100px);  
            transition: opacity 0.5s ease, transform 0.5s ease;
        }
         
        @@keyframes slideIn {
            0% {
                opacity: 0;
                transform: translateY(100px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
         
        .element:nth-child(1) {
            animation: slideIn 1s ease 0.5s forwards;  
        }

        .element:nth-child(2) {
            animation: slideIn 0.5s ease 1s forwards;  
        }

        .element:nth-child(3) {
            animation: slideIn 0.5s ease 1.5s forwards; 
        }
</style>

 
<div class="container">
    <div class="row wow fadeInUp" data-wow-duration=".5s" data-wow-delay=".2s">
        <div class="col-md-12 ">
            <div class="section-title-2 text-center heart-animation" id="titleOurValuesId">
                @{
                    <h2 class="en">@Model.title.TitleEn</h2>
                    <h2 class="ar">@Model.title.TitleAr</h2>
                }
            </div>
        </div>
    </div>
    <div class="row wow fadeInUp" data-wow-duration=".7s" data-wow-delay=".3s">
        @foreach (var item in Model.valuesModel)
        {
            <div class="col-lg-3 col-md-6 col-sm-6 col-12 heart-animation " style="margin-bottom:20px" id="heart">
                <figure class="user-card">
                    <figcaption>
                        <img src="./@item.ImagePath" alt="Values" class="profile">
                        <h5 class="en">@item.TitleEn</h5>
                        <h5 class="ar">@item.TitleAr</h5>
                    </figcaption>
                </figure>
            </div>
        }
    </div>
</div>

@section Scripts{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
        const observerOptions = {
            root: null,
            rootMargin: "0px",
            threshold: 0.5
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.heart-animation').forEach(element => {
            observer.observe(element);
        });
    });



        // JavaScript
        document.addEventListener('DOMContentLoaded', function () {
            window.addEventListener('scroll', revealOnScroll);
            revealOnScroll(); // Trigger on page load

            function revealOnScroll() {
                var elements = document.querySelectorAll('.element');
                elements.forEach(function (element) {
                    if (isElementInViewport(element)) {
                        element.classList.add('visible');
                    }
                });
            }

            function isElementInViewport(el) {
                var rect = el.getBoundingClientRect();
                return (
                    rect.top >= 0 &&
                    rect.bottom <= (window.innerHeight || document.documentElement.clientHeight)
                );
            }
        });

    </script>
}
