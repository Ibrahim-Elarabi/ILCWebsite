@using ILC.BL.Models.Admin.HomeSection.Titles;
@using ILC.BL.Models.Admin.HomeSection.ValuesHome;
@model (List<ILC.BL.Models.Admin.HomeSection.ValuesHome.ValueHomeVM> valuesModel, TitleVM title)
<style>
        figure.user-card {
            background: #fff;
            padding:0px 0px;
            border-radius: 3px;
            text-align: center; 
            /* height: 200px;  */
            transition: all .4s ease;  
        }  
        figure.user-card .profile {
            -webkit-border-radius: 50%;
            -moz-border-radius: 50%;
            border-radius: 50%;
            height: 85px;
            width:85px;
            margin-bottom: 10px; 
        } 
        figure.user-card p {
            margin: 0;
            padding: 0 0 15px 0;
            color: #555;
            line-height: 120%;
            font-size: 1.1rem; 
        }
         
        /*animatio-------------------------------------*/ 

        #heart { 
            position: relative; 
            margin: 0 auto;
        }
 
        @@keyframes heartbeat {
          0% {
            transform: scale(1);
          }
          30% {
            transform: scale(1.15);
          } 
          50% {
            transform: scale(1);  
          }
          70% {
            transform: scale(1.15);
          }
          100% {
            transform: scale(1);
          }
        }

        .heart-animation.animate {
            animation: heartbeat 1s 1; 
        }

        #heart:hover {
            animation: heartbeat 1s 1;
        }

         #titleOurValuesId:hover { 
            animation: heartbeat 1s 1; 
            font-size:30px;

        }

    @@media (max-width: 767px) {
        figure.user-card .profile {
            -webkit-border-radius: 50%;
            -moz-border-radius: 50%;
            border-radius: 50%;
            height: 40px;
            width: 40px;
        }

        .section-title-2 {
            margin-bottom: 40px;
        }
</style>
 
<div class="container">
    <div class="row wow fadeInUp" data-wow-duration=".5s" data-wow-delay=".2s">
        <div class="col-md-12 ">
            <div class="section-title-2 text-center heart-animation" id="titleOurValuesId">
                @{
                    <h2 class="en" style="margin-bottom:0px">@Model.title.TitleEn</h2>
                    <h2 class="ar" style="margin-bottom:0px">@Model.title.TitleAr</h2>
                }
            </div>
        </div>
    </div>
    <div class="row wow fadeInUp text-center" data-wow-duration=".7s" data-wow-delay=".3s">
        @foreach (var item in Model.valuesModel)
        {
            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-6 heart-animation text-center" id="heart">
                <figure class="user-card"> 
                        <figcaption>
                        <img src="./@item.ImagePath" alt="Values" class="profile">
                        <p class="en text-center">@item.TitleEn</p>
                        <p class="ar text-center">@item.TitleAr</p>
                    </figcaption>
                </figure>
            </div>
        }
    </div>
</div> 