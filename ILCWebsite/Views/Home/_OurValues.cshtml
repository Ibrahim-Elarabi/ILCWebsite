@using ILC.BL.Models.Admin.HomeSection.Titles;
@using ILC.BL.Models.Admin.HomeSection.ValuesHome;
@model (List<ILC.BL.Models.Admin.HomeSection.ValuesHome.ValueHomeVM> valuesModel, TitleVM title)
<style>
        figure.user-card {
            background: #fff;
            padding: 20px;
            border-radius: 3px;
            text-align: center; 
            height: 200px; 
            transition: all .4s ease;  
        }  
        figure.user-card .profile {
            -webkit-border-radius: 50%;
            -moz-border-radius: 50%;
            border-radius: 50%;
            height: 100px;
            width: 100px;
            margin-bottom: 20px;
        } 
        figure.user-card p {
            margin: 0;
            padding: 0 0 15px 0;
            color: #555;
            line-height: 120%;
            font-size: 1.1rem; 
        }
         
        /*animatio-------------------------------------*/ 

        #heart {
            position: relative; 
            margin: 0 auto;
        }
 
        @@keyframes heartbeat {
          0% {
            transform: scale(1);
          }
          30% {
            transform: scale(1.15);
          } 
          50% {
            transform: scale(1);
          }
          70% {
            transform: scale(1.15);
          }
          100% {
            transform: scale(1);
          }
        }

        .heart-animation.animate {
            animation: heartbeat 1s 1;
        }

        #heart:hover {
            animation: heartbeat 1s 1; 
        } 
</style> 

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="section-title-2 text-center">
                @{
                    <h2 class="en">@Model.title.TitleEn</h2>
                    <h2 class="ar">@Model.title.TitleAr</h2>
                }
            </div>
        </div>
    </div>
    <div class="row">
        @foreach (var item in Model.valuesModel)
        {
            <div class="col-lg-3 col-md-6 col-sm-6 col-12 heart-animation" style="margin-bottom:20px" id="heart">
                <figure class="user-card">
                    <figcaption>
                        <img src="./@item.ImagePath" alt="Values" class="profile">
                        <h5 class="en">@item.TitleEn</h5>
                        <h5 class="ar">@item.TitleAr</h5>
                    </figcaption>
                </figure>
            </div>
        }
    </div>
</div>

@section Scripts{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
        const observerOptions = {
            root: null,
            rootMargin: "0px",
            threshold: 0.5
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.heart-animation').forEach(element => {
            observer.observe(element);
        });
    });
    </script>
}
