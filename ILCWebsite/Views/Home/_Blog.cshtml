@model List<ILC.BL.Models.Admin.HomeSection.Blog.BlogHomeVM>

<style>
    .blog-item {
        box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.21);
    }
</style>

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="section-title-2 text-center">
                <h2 data-i18n="FROM_BLOG"></h2> 
            </div>
        </div>
    </div>
    <div class="row">
        <div class="blog-carousel">
            <!-- blog-item -->
            @foreach (var item in Model)
            {
                <div class="col-md-12">
                    <article class="blog-item bg-gray">
                        <div class="blog-image">
                            <a href="/Blog/Details?id=@item.Id"><img src="@item.ImagePath" alt="" style="height:200px;object-fit:cover"></a>
                        </div>
                        <div class="blog-info" style="height:130px">
                            <div class="post-title-time">
                                <a href="/Blog/Details?id=@item.Id"><h5 class="en">@item.TitleEn</h5></a>
                                <a href="/Blog/Details?id=@item.Id"><h5 class="ar"> @item.TitleAr</h5></a>

                                <p>@item.CreationDate.GetValueOrDefault().ToString("dd-MMM-yyyy")</p>
                            </div>
                            <p class="en">@Truncate(item.DescriptionEn, 35)</p>
                            <p class="ar">@Truncate(item.DescriptionAr, 35)</p>

                
                        </div>
                    </article>
                </div>
            }
        </div>
        <div class="text-center">
            <a href="/Blog" class="submit-btn-1" data-i18n="more-details"></a>
        </div>
    </div>
</div>

@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}