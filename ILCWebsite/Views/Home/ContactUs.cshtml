<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<style>
        .social-icons {
            display: flex;
            justify-content: center;
            list-style: none;
            padding: 20px;
        }

        .social-icons li {
            margin: 0 10px;
            padding: 5px;
        }

        .social-icons a {
            text-decoration: none;
        }

        .social-icons svg {
            width: 48px; /* Adjust the size here */
            height: 48px; /* Adjust the size here */ 
            fill: #eee; /* Default color */
        }

        .social-icons a:hover svg { 
            fill: #00f;
        }
</style>
<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs">
                    <p class="breadcrumbs-title" data-i18n="ContactUs"></p>
                    <ul class="breadcrumbs-list">
                        <li><a asp-controller="Home" asp-action="index" data-i18n="Home"></a></li>
                        <li data-i18n="ContactUs"></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="customer-support pt-60 pb-115" id="ContactUs">
    <div class="container">
        <div class="row"> 
            <div class="col-sm-5 col-xs-12">
                <div class="get-in-toch">
                    <div class="section-title mtb-30">
                        <h3 data-i18n="CUSTOMER SUPPORT"></h3> 
                    </div>
