@using ILC.BL.Models.Admin.HomeSection.Titles;
@model (List<ILC.BL.Models.Admin.HomeSection.EventGalaries.EventGalaryVM> EventGalaryModel, TitleVM title)
<style>
    .gallary{ 
        position:relative;
        /* background-color: #005c67; */
        background-color: #fff; 
    } 
    .image img {
       width:100%;
    }

    image-container {
        position: relative;
        width: 100%;
    }

    .image-container img {
        width: 100%;
        height: 300px;
    }

    .image-title {
        position: absolute;
        bottom: 0px;
        left: 0px;
        background-color: rgba(0, 0, 0, 0.3);
        color: #aaa;
        padding: 5px;
        border-radius: 3px; 
    }

    .image-title:hover {
        color: #999;
        background-color: rgba(0, 0, 0, 0.7);
        /* background-color:#00f; */
    }
</style>
<div class="container" >
    <div class="row">
        <div class="col-md-12">
            <div class="section-title-2 text-center">
                @{
                    <h2 class="en">@Model.title.TitleEn</h2>
                    <h2 class="ar">@Model.title.TitleAr</h2>
                    <p class="en">@Model.title.DescriptionEn</p>
                    <p class="ar">@Model.title.DescriptionAr</p>
                }
            </div>
        </div>
    </div>
    <div class="row  gallary" >
        @foreach (var item in Model.EventGalaryModel)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12" style="padding:2px">
                <div class="image row" style="position:relative; width:100%;">
                    <a href="@item.ImagePath" data-lightbox="image-1" data-title="@item.TitleEn">
                        <img src="@item.ImagePath" style="height:250px; width:100%;" />
                    </a>                    
                    <div class="image-title col-md-12 text-center" style="">
                        <span class="en" style="font-size:15px;color:#eee">@item.TitleEn</span>
                        <span class="ar" style="font-size:15px;color:#eee">@item.TitleAr</span>
                    </div> 
                </div> 
            </div>
        } 
    </div>

</div>

@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}