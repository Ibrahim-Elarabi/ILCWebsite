@using ILC.BL.Models.Admin.HomeSection.Titles;
@model (List<ILC.BL.Models.Admin.HomeSection.EventGalaries.EventGalaryVM> EventGalaryModel, TitleVM title)
<style>
    /* site.css */

    .gallery-section {
        padding: 20px;
        background-color: #fff;
    }

    .gallery-container {
        display: flex;
        flex-wrap: wrap;
        /* gap: 10px; */
    }

    .gallery-item {
        position: relative;
        width: 200px;
        height: 200px;
        background-size: cover;
        background-position: center;
        text-decoration: none;
        color: #fff;
    }

    .gallery-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(0, 0, 0, 0.5);
        padding: 10px;
        text-align: center;
    }

    .gallery-item h3 {
        margin: 0;
        font-size: 16px;
    }

</style>
<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="section-title-2 text-center">
                @{
                    <h2 class="en">@Model.title.TitleEn</h2>
                    <h2 class="ar">@Model.title.TitleAr</h2>
                    <p class="en">@Model.title.DescriptionEn</p>
                    <p class="ar">@Model.title.DescriptionAr</p>
                }
            </div>
        </div>
    </div>
    <div class="row"> 
        @foreach (var item in Model.EventGalaryModel)
        {
            <div class="col-md-3 gallery-container pb-20" >
                <a href="/Service/Details?id=@item.Id" class="gallery-item" style="background-image: url('@item.ImagePath'); width:100%">
                    <div class="gallery-overlay">
                        <h3 style="color:#aaa">@item.TitleEn</h3> <!-- Optional: Display title of the event -->
                    </div>
                </a>
            </div>
        } 
    </div>

</div>

@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}