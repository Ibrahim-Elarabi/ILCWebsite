@using ILC.BL.Models.Admin.HomeSection.Titles;
@using ILC.BL.Models.Admin.HomeSection.ValuesHome;
@model List<ILC.BL.Models.Admin.HomeSection.AboutUs.AboutUsHomeVM>
@{
    var Values = (TitleVM)ViewBag.values;  
    var OurValuesList = (List<ValueHomeVM>)ViewBag.OurValuesListVM;
    int t = 0;
}
<style>
    figure.user-card {
        background: #f5f5f5;
        padding: 20px;
        border-radius: 3px;
        text-align: center;
        border: 1px solid #aaa; 
        overflow: hidden;
        transition: all .4s ease; 
    }

        figure.user-card:hover {
            border: 1px solid #888;
            box-shadow: 7px 7px 25px rgba(0, 0, 0, 0.17), -7px 7px 25px rgba(0, 0, 0, 0.17);
            transform: scale(1.01);
        }

        figure.user-card:hover .profile {
            border: 5px solid #000;
        }

        figure.user-card .profile {
            -webkit-border-radius: 50%;
            -moz-border-radius: 50%;
            border-radius: 50%;
            height: 80px;
            width: 80px;
            margin-bottom: 20px;
        }
         
        figure.user-card p {
            height: 120px;
            overflow: hidden;
            display: block;
            width: 100%;
            margin-bottom: 20px;
            line-height: 25px;
            font-size: 14px;
        } 
    .img{ 
        border-radius:5px
    }
    .img:hover{
      /*   border-top-left-radius:50px;
            border-bottom-right-radius:30px; */
            transform: scale(1.05); 
            transition: transform 0.3s ease;
            /* box-shadow: 5px 5px 10px #efefef,-5px -5px 20px #aaa; */
        } 
 
</style>

<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs">
                    <p class="breadcrumbs-title" data-i18n="AboutUs"></p>
                    <ul class="breadcrumbs-list">
                        <li><a asp-controller="Home" asp-action="index" data-i18n="Home"></a></li>
                        <li data-i18n="AboutUs"></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="about-sheltek-area pt-50 pb-30">
 <div class="container"> 
     @foreach (var item in Model)
        {
            t += 4;
            var delay = $".{t}s"; 
            <div class="row ar rtl wow fadeInUp" data-wow-duration=".8s" data-wow-delay="@delay">
                <div class="row">
                    <div class="col-sm-4 hidden-xs">
                        <div class="about-image ">
                            <img class="img" src="@item.ImagePath" style="height:220px">
                        </div>
                    </div>
                    <div class="col-sm-8 col-xs-12">
                        <h3 class="ar">@item?.TitleAr</h3>
                        <div class="rtl ar">
                            @item.TextAr
                        </div>
                    </div>
                </div>
            </div>
            <div class="row en wow fadeInUp" data-wow-duration=".8s" data-wow-delay="@delay">
                <div class="row">
                    <div class="col-sm-8 col-xs-12"> 
                       <h4 class="en" style="text-transform: uppercase;">@item?.TitleEn</h4> 
                        <div class="en">
                            @item.TextEn
                        </div> 
                    </div>
                    <div class="col-sm-4 hidden-xs">
                        <div class="about-image  ">
                            <img class="img" src="@item.ImagePath" style="height:220px">
                        </div>
                    </div>
                </div>
            </div>
            <hr />
        }

 
        @* --------------------- Values ---------------------- *@ 
        <div class="row">
            <div class="col-md-12">
                <div class="section-title-2 text-center">
                    @{
                        <h3 class="en pb-20" style="text-transform: uppercase;">@Values?.TitleEn</h3>
                        <h2 class="ar pb-20">@Values?.TitleAr</h2>
                        <p class="en">@Values?.DescriptionEn</p>
                        <p class="ar">@Values?.DescriptionAr</p>
                    }
                </div>
            </div>
            @foreach (var item in OurValuesList)
            {
                <div class="col-lg-6 col-md-6 col-sm-6 col-12" style="margin-bottom:20px">
                    <figure class="user-card">
                        <figcaption>
                            <img src="@item.ImagePath" alt="Values" class="profile">
                            <h4 class="en">@item.TitleEn</h4>
                            <h4 class="ar">@item.TitleAr</h4>
                            <p class="en">@item.DescriptionEn</p>
                            <p class="ar">@item.DescriptionAr</p>
                        </figcaption>
                    </figure>
                </div>
            }
        </div> 
       
    </div> 
</div> 


@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}