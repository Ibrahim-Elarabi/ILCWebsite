@using ILC.Domain.DBEntities;
@model ILC.BL.Models.WebSite.Home.HomePageVM

<!-- SLIDER SECTION START -->
@if (Model != null && Model.Silder != null)
{
    @await Html.PartialAsync("_SliderHome", Model.Silder) 
}
<!-- SLIDER SECTION END -->
<!-- Start page content -->
<section id="page-content" class="page-wrapper">



    <div class="booking-area bg-3 call-to-bg plr-140 pt-75">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-3 col-sm-4 col-xs-12">
                    <div class="section-title text-white">
                        <h3 style="color:black" data-i18n="SOME">SOME</h3>
                        <h2 class="h1" style="color:black" data-i18n="FUN-FACTOR">FUN FACTOR</h2>
                    </div>
                </div>
                <div class="col-md-9 col-sm-8 col-xs-12">
                    <div class="booking-conternt  clearfix">
                        <div class="counter-content">
                            @foreach (var item in Model.Achievements)
                            {
                                <div class="counter-item">
                                    <h2>
                                        <i class="fa fa-home" style="color:#e2a165" aria-hidden="true"></i>
                                        <span class="counter">@item.Value</span>
                                    </h2>
                                    <p class="en">@item.TitleEn</p>
                                    <p class="ar">@item.TitleAr</p>
                                </div>
                            }
                        </div>
                        <div class="booking-imgae">
                            <img src="images/others/booking.jpg" style="max-height:270px" alt="">
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- ABOUT SHELTEK AREA START -->
    <div class="about-sheltek-area ptb-115" id="AboutUs">
        @if (Model != null && Model.Silder != null)
        {
            @await Html.PartialAsync("_AboutUS", Model.AboutUS)
        }

    </div>
    <!-- ABOUT SHELTEK AREA END -->




    <!-- SERVICES AREA START -->
    <div class="services-area pb-60 mb-115">
        @if (Model != null && Model.Services?.Count > 0)
        { 
            @* @await Html.PartialAsync("_Service", Model.Services) *@
            @await Html.PartialAsync("_Service", (Model.Services,(Title)ViewBag.service))
        }
    </div>
    <!-- SERVICES AREA END -->






    <!-- BOOKING AREA START --> 
    <!-- EventsGalaries AREA START -->
    <div class="services-area pb-60 mb-115">
        @if (Model != null && Model.EventsGalaries?.Count > 0)
        {
            @await Html.PartialAsync("_EventsGalaries", Model.EventsGalaries)
        }
    </div>
    <!-- EventsGalaries AREA END -->

      
    <!-- BOOKING AREA END -->
    <!-- FEATURED FLAT AREA START -->
    <div class="featured-flat-area pt-75 pb-80">
        @if (Model != null && Model.Products?.Count > 0)
        {
            @await Html.PartialAsync("_Product", Model.Products)
        }
    </div>
    <!-- FEATURED FLAT AREA END -->
    <!-- OUR AGENTS AREA START -->
    <div class="our-agents-area pt-75">
        @if (Model != null && Model.Agents?.Count > 0)
        {
            @await Html.PartialAsync("_Agent", Model.Agents)
        }
    </div>
    <!-- OUR AGENTS AREA END -->
    <!-- BLOG AREA START -->
    <div class="blog-area pb-80">
        @if (Model != null && Model.Blogs?.Count > 0)
        {
            @await Html.PartialAsync("_Blog", Model.Blogs)
        }
    </div>
</section>
<!-- BLOG AREA END -->
<!-- END STAFF -->
<!-- START RESOURSES AND DOWNLOADS -->
<div class="downloads_resourses pt-75 pb-80">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="section-title-2 text-center">
                    <h2 data-i18n="DOWNLOADS_RESOURSES"></h2>
                    <p data-i18n="DOWNLOADS_RESOURSES_DESC"></p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="text-center">
                <h4 data-i18n="DOWNLOADS-TEMPLATES" style="margin:20px auto"></h4>
                <hr />
            </div>
            @foreach (var item in Model.DownloadsTemplates)
            {
                <div class="col-md-2 text-center">
                    <div>
                        <a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" title="Download File" target="_blank" title="View File"><img src="~/images/file.png" alt="" style="height:100px;object-fit:fill"></a>
                    </div>
                    <div>
                        <h6><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" title="View File" target="_blank" class="en">@item.TitleEn</a></h6>
                        <h6><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" title="View File" target="_blank" class="ar">@item.TitleAr</a></h6>
                    @*     <p class="en">@Truncate(item.DescriptionEn, 20)</p>
                        <p class="ar">@Truncate(item.DescriptionAr, 20)</p> *@
                    </div>
                </div>
            }
        </div>


        <div class="row">
            <div class="text-center">
                <h4 data-i18n="DOWNLOADS-CATEGORIES" style="margin:20px auto"></h4>
                <hr />
            </div>

            @foreach (var item in Model.DownloadsCategories)
            {
                <div class="col-md-2 text-center">
                    <div>
                        <a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" title="View File" target="_blank"><img src="~/images/file.png" alt="" style="height:100px;object-fit:fill"></a>
                    </div>
                    <div>
                        <h6><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" title="View File" target="_blank" class="en">@item.TitleEn</a></h6>
                        <h6><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" title="View File" target="_blank" class="ar">@item.TitleAr</a></h6>
                     @*    <p class="en">@Truncate(item.DescriptionEn, 20)</p>
                        <p class="ar">@Truncate(item.DescriptionAr, 20)</p> *@
                    </div>
                </div>
            }
        </div>
    </div>
</div>




<!-- START STAFF -->
<div class="staff pt-75 pb-80">
    @if (Model != null && Model.Staffs?.Count > 0)
    {
        @await Html.PartialAsync("_Staff", Model.Staffs)
    }
</div>


<!-- END RESOURSES AND DOWNLOADS -->
<!-- CONTACT AREA START -->
<div class="customer-support pt-60 pb-115" id="ContactUs">
    <div class="container">


        <div class="row">

            <div class="col-md-12"> 
                <div class="section-title-2 text-center">
                    <h2 data-i18n="CONTACT-US"></h2>
                </div>
            </div>


            <div class="col-sm-5 col-xs-12">
                <!-- get-in-toch -->
                <div class="get-in-toch">
                    <div class="section-title mb-30">
                        <h3 data-i18n="CUSTOMER SUPPORT"></h3>

                    </div>
                    <div class="contact-desc mb-50">
                        <p><span data-placement="top" data-toggle="tooltip" data-original-title="The name you can trust" class="tooltip-content" data-i18n="CUSTOMER_SUPPORT"> </p>
                    </div>
                    <ul class="contact-address">
                        <li>
                            <div class="contact-address-icon">
                                <img src="~/images/icons/location-2.png" alt="">
                            </div>
                            <div class="contact-address-info">
                                <span>Ryaidh, Saudi arabia  || الرياض - السعودية </span>
                                <span>Gedda - Saudi arabia || جدة - السعودية</span>
                            </div>
                        </li>
                        <li>
                            <div class="contact-address-icon">
                                <img src="~/images/icons/phone-3.png" alt="">
                            </div>
                            <div class="contact-address-info">
                                <span>+966531978944</span>
                            </div>
                        </li>
                        <li>
                            <div class="contact-address-icon">
                                <img src="~/images/icons/world.png" alt="">
                            </div>
                            <div class="contact-address-info">
                                <span>Email : info@sheltek.com</span>
                                <span>Web :<a href="#" target="_blank"> www.ILC.com</a></span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-sm-7 col-xs-12">
                <div class="contact-messge contact-bg">
                    <!-- blog-details-reply -->
                    <div class="leave-review">
                        <h5 data-i18n="LEAVE_MESSAGE"></h5>
                        <form asp-controller="Home" asp-action="LeaveMessage" id="contact-form" method="post">
                            <input class="en" type="text" name="name" placeholder="Your name">
                            <input class="ar" type="text" name="name" placeholder="الاسم">

                            <input class="en" type="email" name="email" placeholder="Email">
                            <input class="ar" type="email" name="email" placeholder="الايميل">

                            <textarea class="en" name="message" placeholder="Write here"></textarea>
                            <textarea class="ar" name="message" placeholder="اكتب هنا"></textarea>

                            <button type="submit" class="submit-btn-1" data-i18n="SUBMIT"> </button>

                        </form>
                        <p class="form-messege mb-0"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- CONTACT AREA END -->
<!--
        </section> -->
<!-- End page content -->
@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}
