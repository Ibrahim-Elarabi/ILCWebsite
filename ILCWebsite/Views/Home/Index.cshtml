@using ILC.BL.Models.Admin.HomeSection.Titles; 
@model ILC.BL.Models.WebSite.Home.HomePageVM
<style>  
            .booking-imagae {
                position: relative;
                overflow: hidden;
                height: 150px;
                width: 100%;
            }

            .slider-wrapper {
                display: flex;
                position: absolute;
                top: 0;
                left: 0;
                width: 200%;
                animation: slide 35s linear infinite;
            }

            .slider-image { 
                width: 32%;
                height: 100%;
                margin: .2% .3%;
                padding: 0;
            }

            @@keyframes slide {
                0% {
                    transform: translateX(0%);
                }
                100% {
                    transform: translateX(-50%);
                }
            } 

             
</style>

<!-- SLIDER SECTION START -->
@if (Model != null && Model.Silder != null)
{
    @await Html.PartialAsync("_SliderHome", Model.Silder) 
} 


<section id="page-content" class="page-wrapper">



    <div class="booking-area bg-3 call-to-bg plr-140">
        <div class="container-fluid">
            <div class="row divTitle flex" >
                <div class="col-md-3 col-sm-4 col-xs-12">
                    <div class="section-title text-white innerTitle">
                        <h3 style="color:black" data-i18n="SOME">SOME</h3>
                        <h2 class="h1" style="color:black" data-i18n="FUN-FACTOR">FUN FACTOR</h2>
                    </div>
                </div>
                <div class="col-md-9 col-sm-8 col-xs-12">
                    <div class="flex booking-conternt clearfix row" style="height:150px">
                        <div class="counter-content" >
                            @foreach (var item in Model.Achievements)
                            {
                                <div class="counter-item">
                                    <h2>
                                        <i class="fa fa-home" style="color:#e2a165" aria-hidden="true"></i>
                                        <span class="counter">@item.Value</span>
                                    </h2>
                                    <p class="en">@item.TitleEn</p>
                                    <p class="ar">@item.TitleAr</p>
                                </div>
                            }
                        </div>
                        <div class="booking-imagae" style="width:40%;margin:0px;overflow:hidden;">
                            <div class="slider-wrapper">
                                <img class="slider-image" src="images/others/booking.jpg" style="object-fit:cover;height:150px">
                                <img class="slider-image" src="images/others/booking2.jpg" style="object-fit:cover;height:150px">
                                <img class="slider-image" src="images/others/booking3.jpg" style="object-fit:cover;height:150px">
                                <img class="slider-image" src="images/others/booking.jpg" style="object-fit:cover;height:150px">
                                <img class="slider-image" src="images/others/booking2.jpg" style="object-fit:cover;height:150px">
                                <img class="slider-image" src="images/others/booking3.jpg" style="object-fit:cover;height:150px">
                                <img class="slider-image" src="images/others/booking.jpg" style="object-fit:cover;height:150px">
                                <img class="slider-image" src="images/others/booking2.jpg" style="object-fit:cover;height:150px">
                                <img class="slider-image" src="images/others/booking3.jpg" style="object-fit:cover;height:150px">
                            </div>
                         </div> 
                    </div>
                </div>

            </div>
        </div>
    </div>
     
    <div class="about-sheltek-area ptb-115" id="OurValues">
        @if (Model != null && Model.OurValues.Count > 0)
        { 
