@model ILC.BL.Models.Admin.HomeSection.Service.ServiceHomeVM
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Details";
}

<style>
    .bread-bg-1 {
        background: rgba(0, 0, 0, 0) url("images/bg/service.jpg") no-repeat scroll 0 0 / cover;
    }
</style>
<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs">
                    @* <h2 class="breadcrumbs-title" data-i18n="Services"></h2> *@
                    <h2 class="breadcrumbs-title en">@Model.TitleEn</h2>
                    <h2 class="breadcrumbs-title ar">@Model.TitleAr</h2>
                    <ul class="breadcrumbs-list">
                        <li><a asp-controller="Home" asp-action="index" data-i18n="Home"></a></li>
                        <li data-i18n="Services"></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<section id="page-content" class="page-wrapper">
    <!-- FEATURED FLAT AREA START -->
    <div class="featured-flat-area pt-60 pb-60 en">
        <div class="container">
            <div class="featured-flat">
                <div class="row">
                    <div class="col-md-12">
                        <h3 class="en">@Model.TitleEn</h3>
                        <h3 class="ar">@Model.TitleAr</h3>
                        <img src="@Model.ImagePath" alt=""  style="margin:20px 0px;max-height:500px">
                    </div>
                    <div class="col-md-12 col-sm-12 col-xs-12"> 
                        <p class="en" style="font-weight:bold">@Model.SubTitleEn</p>
                        <p class="ar" style="font-weight:bold">@Model.SubTitleAr</p>
                        <p class="en">@Model.DescriptionEn</p>
                        <p class="ar">@Model.DescriptionAr</p> 
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="featured-flat-area pt-60 pb-60 ar text-right">
        <div class="container">
            <div class="featured-flat">
                <div class="row">
                    <div class="col-md-12">
                        <h3 class="en">@Model.TitleEn</h3>
                        <h3 class="ar">@Model.TitleAr</h3> 
                        <img src="@Model.ImagePath" alt=""  style="margin:20px 0px;max-height:500px">
                    </div>
                    <div class="col-md-12 col-sm-12 col-xs-12"> 
                        <p class="en" style="font-weight:bold">@Model.SubTitleEn</p>
                        <p class="ar" style="font-weight:bold">@Model.SubTitleAr</p>
                        <p class="en">@Model.DescriptionEn</p>
                        <p class="ar">@Model.DescriptionAr</p> 
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>
