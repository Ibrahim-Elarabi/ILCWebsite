    <script>
          
        $(document).ready(function () {

            const userPreferredLanguage = localStorage.getItem("language") || "en";
            if (userPreferredLanguage === 'ar') {
                $('.page-wrapper').css({ 'text-align': 'right', 'direction': 'rtl' });
                $('.amenities-list > li').addClass('position-relative');
            }

            $('#openModalBtn').click(function () {
                $.ajax({
                    url: '@Url.Action("Create", "Inquiry")',
                    type: 'GET',
                    success: function (data) {
                        $('#myModal .modal-body').html(data);
                        $('#myModal').modal('show');
                        $('#ProductIdInModel').val($('#productId').val());
                        // getCountries();
                         //appendCountryCodes (); 
                    },
                    error: function () {
                        console.log('Error occurred while fetching data.');
                    }
                });
            });
             
        });

         
        function CreateInquiry(e) {
            if (validCreateInquiryForm()) {
            if (e) {
                e.preventDefault();
                e.returnValue = false;
            }
            var form = $('#CreateInquiryForm').serialize();
                console.log(form);
            axios.post('/Product/Create', form)
                .then(res => {
                    console.log(res);
                    $("#divLoader").hide();
                    if (res && res.data && res.data.success) {
                        console.log("11111");
                        if (res.data.success) {
                            console.log("222222");
                            swal.fire({
                                icon: "success",
                                title: "Success",
                                text: res.data.message,
                            }).then(function () {
                                window.location.reload();
                            });
                        }
                        else {
                            swal.fire({
                                icon: "warning",
                                title: "Failed",
                                text: res.data.message
                            });
                        }
                    }
                    else {
                        console.log("3333");
                    }
                })
                .catch(error => {
                    console.error('An error occurred:', error);
                });
            } 
        }



        function validCreateInquiryForm() {
            var validName = doRequiredCheck('Name', 'Name');
            var validLastName = doRequiredCheck('LastName', 'Last Name');
            var validCountry = doRequiredCheck('Country', 'Country');
            var validCity = doRequiredCheck('City', 'City');
            var validCountryCode = doRequiredCheck('CountryCode', 'Country Code');
            var validPhone = doRequiredCheck('Phone', 'Phone');
            var validEmail = doRequiredCheck('Email', 'Email') ? doCheckPattern('Email', emailPattern, 'Email') : false;
            var validSubject = doRequiredCheck('Subject', 'Subject');
            var validMessage = doRequiredCheck('Message', 'Message'); 
            if (validName && validLastName && 
                            validCountry &&
                            validCity &&
                            validCountryCode &&
                            validPhone &&
                            validEmail &&
                            validSubject &&
                            validMessage )
            {
                return true;
            }
            else {
                return false;
            }
        }


