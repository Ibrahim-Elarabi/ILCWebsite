@model ILC.BL.Models.Admin.HomeSection.Product.ProductHomeVM
@using System.Globalization
@{
    Layout = "_Layout";
    var ProductCategoryEn = ViewBag.ProductCategoryEn;
    var ProductCategoryAr = ViewBag.ProductCategoryAr;
    var ProductSubCategoryEn = ViewBag.ProductSubCategoryEn; 
    var ProductSubCategoryAr = ViewBag.ProductSubCategoryAr; 
}

<style>
    .position-relative:before {
        content: ''; /* Ensure content exists for pseudo-element */
        position: relative !important;  
         margin-left:10px;
    } 
</style> 
<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs"> 
                    <p class="breadcrumbs-title en">@Model?.TitleEn</p>
                    <p class="breadcrumbs-title ar">@Model?.TitleAr</p>
                    <ul class="breadcrumbs-list">
                        <li><a asp-controller="Home" asp-action="index" data-i18n="Home"></a></li>
                        <li class="en">@ProductCategoryEn</li>
                        <li class="ar">@ProductCategoryAr</li>
                        <li class="en">@ProductSubCategoryEn</li>
                        <li class="ar">@ProductSubCategoryAr</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Start page content -->
<section id="page-content" class="page-wrapper">  
    <!-- PROPERTIES DETAILS AREA START -->
    <div class="properties-details-area pt-30 pb-30">
        <div class="container">


            @*-------------------------Product Details---------------------------*@
            <div class="row mb-20">
                <h3 style="padding:12px" class="en">@Model?.TitleEn</h3>
                <h3 style="padding:12px" class="ar">@Model?.TitleAr</h3>
                <div class="col-lg-3 col-md-3 col-sm-5 col-xs-12">
                    <div class="pro-details-image mb-40">
                        <div class="pro-details-big-image">
                            <div class="tab-content">
                                @foreach (var image in Model?.Images)
                                {
                                    <div role="tabpanel" class="tab-pane fade @(image == Model?.Images.FirstOrDefault() ? "in active" : "")" id="pro-@(image.Id)">
                                        <a href="@image.ImagePath" data-lightbox="image-@(image.Id)" data-title="@Model?.TitleEn">
                                            <img src="@image.ImagePath" alt="" class="imgDetails" style="" >
                                        </a>
                                    </div>
                                } 
                            </div>
                        </div>
                        <div class="pro-details-carousel"> 
                            @foreach (var image in Model?.Images)
                            {
                                <div class="pro-details-item">
                                    <a href="#pro-@(image.Id)" data-toggle="tab">
                                        <img src="@image.ImagePath" alt="">
                                    </a>
                                </div>
                            }
                        </div>
                    </div>  
                    
                    <div id="myModal" class="modal fade" tabindex="-1" role="dialog">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header" style="background-color:#337ab7;">
                                     <h5 class="text-center" style="color:#fff">Create Inquiry</h5> 
                                </div>
                                <div class="modal-body"> 
                                </div> 
                            </div>
                        </div>
                    </div>

                </div>
                <div class="col-lg-9 col-md-9 col-sm-12  col-xs-12">
                    <!-- pro-details-description -->
                    <h4 data-i18n="AboutProduct"></h4>
                    <div class="pro-details-description mb-20">
                        <p class="en">@Model?.DescriptionEn</p>
                        <p class="ar">@Model?.DescriptionAr</p>
                    </div>
                    <!-- pro-details-short-info -->
                    @if (Model?.Specifications?.Count() > 0)
                    {
                        <div class="pro-details-short-info mb-40">
                            <div class="row">
                                <div class="col-sm-12 col-xs-12">
                                    <div class="pro-details-amenities">
                                        <h4 data-i18n="Properties"></h4>
                                        <div class="pro-details-amenities-inner bg-gray">
                                            <ul class="amenities-list">
                                                @foreach (var item in Model?.Specifications)
                                                {
                                                    <li>
                                                        <span style="font-weight:bold" class="en">@item?.TitleEn : </span>
                                                        <span style="font-weight:bold" class="ar">@item?.TitleAr : </span>
                                                        <p style="display:inline" class="en">
                                                            @item?.DescriptionEn
                                                        </p>
                                                        <p style="display:inline" class="ar">
                                                            @item?.DescriptionAr
                                                        </p>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                        <div class="row pt-20">
                                            <div class="col-md-12">
                                                <div class="en">
                                                    <img src="~/images/icons/whatsapp.jpg" style="width:35px;float: left;margin-right:10px">
                                                    <div class="header-info" style="float: left;">
                                                        <h6>
                                                            <a href="https://api.whatsapp.com/send?phone=9660543600101">+9660543600101</a>
                                                        </h6>
                                                        <p style="font-size:13px;" data-i18n="you-can-chat-us"></p>
                                                    </div>
                                                </div>
                                                <div class="ar">
                                                    <img src="~/images/icons/whatsapp.jpg" style="width:35px;float: right;margin-left:10px">
                                                    <div class="header-info" style="float: right;">
                                                        <h6 class="">
                                                            <a href="https://api.whatsapp.com/send?phone=9660543600101"> +9660543600101</a>
                                                        </h6>
                                                        <p style="font-size:15px;"  data-i18n="you-can-chat-us"></p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                   }
                </div> 
            </div> 
             
            @*-------------------------Similar products---------------------------*@
                @if (Model?.SimilarProducts?.Count() > 0)
                {
                    <div class="row">
                        <div class="row col-md-12 pb-40">
                            <div class="container">
                                <div class="text-center">
                                    <h3 data-i18n="SimilarProducts" style="text-transform:uppercase"></h3>
                                </div>
                            </div>
                        </div>
                        <div class="row col-md-12">
                            @foreach (var item in Model?.SimilarProducts)
                            {
                                <div class="col-md-2 col-sm-4 col-xs-6">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id"><img src="@item.ImagePath" alt="" style="height:250px;width:100%;object-fit:fill"></a>
                                    <ul>
                                        <li>
                                            <p class="pt-10 en"><b>Model</b> : @Truncate(item.Code, 60)</p>
                                            <p class="pt-10 ar"><b>موديل</b> :@Truncate(item.Code, 60)</p>
                                        </li>
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>

                }

                 
            @*-------------------------Send Inquires---------------------------*@
            <div class="row">
                <input type="hidden" value="@Model.Id" id="productId" />
                <div class="text-right">
                    <button id="openModalBtn" class="btn btn-primary"><span data-i18n="SendInquiry"></span></button>
                </div> 
            </div> 

        </div>
    </div>
    <!-- PROPERTIES DETAILS AREA END --> 
</section>








@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}
<!-- End page content -->
@section Scripts {
    <script src="~/js/npm_axios_dist_axios.min.js"></script> 
    <script src="~/customscript/shared.js"></script>
    <script>
          
        $(document).ready(function () {

            const userPreferredLanguage = localStorage.getItem("language") || "en";
            if (userPreferredLanguage === 'ar') {
                $('.page-wrapper').css({ 'text-align': 'right', 'direction': 'rtl' });
                $('.amenities-list > li').addClass('position-relative');
            }

            $('#openModalBtn').click(function () {
                $.ajax({
                    url: '@Url.Action("Create", "Inquiry")',
                    type: 'GET',
                    success: function (data) {
                        $('#myModal .modal-body').html(data);
                        $('#myModal').modal('show');
                        $('#ProductIdInModel').val($('#productId').val());
                        // getCountries();
                         //appendCountryCodes (); 
                    },
                    error: function () {
                        console.log('Error occurred while fetching data.');
                    }
                });
            });
             
        });

         
        function CreateInquiry(e) {
            if (validCreateInquiryForm()) {
            if (e) {
                e.preventDefault();
                e.returnValue = false;
            }
            var form = $('#CreateInquiryForm').serialize(); 
            axios.post('/Product/Create', form)
                .then(res => { 
                    if (res && res.data && res.data.success) {
                        console.log("11111");
                        if (res.data.success) {
                            console.log("222222");
                            swal.fire({
                                icon: "success",
                                title: "Success",
                                text: res.data.message,
                            }).then(function () {
                                window.location.reload();
                            });
                        }
                        else {
                            swal.fire({
                                icon: "warning",
                                title: "Failed",
                                text: res.data.message
                            });
                        }
                    }
                    else {
                        console.log("3333");
                    }
                })
                .catch(error => {
                    console.error('An error occurred:', error);
                });
            } 
        }



        function validCreateInquiryForm() {
            var validName = doRequiredCheck('Name', 'Name');
            var validLastName = doRequiredCheck('LastName', 'Last Name');
            var validCountry = doRequiredCheck('Country', 'Country');
            var validCity = doRequiredCheck('City', 'City');
            var validCountryCode = doRequiredCheck('CountryCode', 'Country Code');
            var validPhone = doRequiredCheck('Phone', 'Phone');
            var validEmail = doRequiredCheck('Email', 'Email') ? doCheckPattern('Email', emailPattern, 'Email') : false;
            var validSubject = doRequiredCheck('Subject', 'Subject');
            var validMessage = doRequiredCheck('Message', 'Message'); 
            if (validName && validLastName && 
                            validCountry &&
                            validCity &&
                            validCountryCode &&
                            validPhone &&
                            validEmail &&
                            validSubject &&
                            validMessage )
            {
                return true;
            }
            else {
                return false;
            }
        }
         


        function toggleButton() {
            var checkbox = document.getElementById('enable');
            var button = document.getElementById('save');

            if (checkbox.checked) {
                button.disabled = false;
            } else {
                button.disabled = true;
            }
        }

    </script>
}
