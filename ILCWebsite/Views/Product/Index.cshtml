@model List<ILC.BL.Models.Admin.HomeSection.Product.ProductHomeVM>
@using System.Globalization
@{
    Layout = "_Layout";
    var MainCategoryNameEn = ViewBag.MainCategoryNameEn;
    var MainCategoryNameAr = ViewBag.MainCategoryNameAr;
}
<!-- BREADCRUMBS AREA START -->
<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs">
                    <p class="breadcrumbs-title en">@MainCategoryNameEn</p>
                    <p class="breadcrumbs-title ar">@MainCategoryNameAr</p>
                    <ul class="breadcrumbs-list">
                        <li><a asp-controller="Home" asp-action="index" data-i18n="Home"></a></li>
                        <li class="en">Products</li> 
                        <li class="ar">المنتجات</li> 
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- BREADCRUMBS AREA END -->
<!-- Start page content -->
<section id="page-content" class="page-wrapper">

    <!-- FEATURED FLAT AREA START -->
    <div class="featured-flat-area pt-115 pb-60">
        <div class="container">
            <div class="featured-flat">
                <div class="row"> 
                    @foreach(var item in Model){  
                        <div class="col-md-3 col-sm-6 col-xs-12">
                            <div class="flat-item">
                                <div class="flat-item-image">
                                    <a asp-controller="Product" asp-action="Details"><img src="@item.ImagePath" alt="" style="height:350px;object-fit:cover"></a>
                                    <div class="flat-link">
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" data-i18n="more-details"></a>
                                    </div>
                                    <ul class="flat-desc" style="height:70px;">
                                        <li>
                                            <p class="en" style="color:#eee">@Truncate(item.TitleEn, 60)</p>
                                            <p class="ar" style="color:#eee">@Truncate(item.TitleAr, 60)</p> 
                                        </li> 
                                    </ul>
                                </div> 
                            </div>
                       </div> 
                    } 
                </div>
            </div>
        </div>
    </div>

</section>
<!-- End page content -->
@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}
