@model List<ILC.BL.Models.Admin.HomeSection.Product.SubCategoryWithProducts>
@using System.Globalization
@{
    Layout = "_Layout";
    var MainCategoryNameEn = ViewBag.MainCategoryNameEn;
    var MainCategoryNameAr = ViewBag.MainCategoryNameAr;
} 
<style>
    .btnMore{
        background-color: transparent;
        font-weight:bold;
        color: #17a2b8;
        padding: 5px 20px;
        border: 2px solid #17a2b8;
        border-radius: 5px;
    }
    .btnMore:hover{
            background-color: transparent;
            color: #444;
            border: 2px solid #444;
    }
</style>
<!-- BREADCRUMBS AREA START -->
<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs">
                    <p class="breadcrumbs-title en">@MainCategoryNameEn</p>
                    <p class="breadcrumbs-title ar">@MainCategoryNameAr</p>
                    <ul class="breadcrumbs-list">
                        <li><a asp-controller="Home" asp-action="index" data-i18n="Home"></a></li>
                        <li class="en">Products</li> 
                        <li class="ar">المنتجات</li>
                        <li class="en">@MainCategoryNameEn</li>
                        <li class="ar">@MainCategoryNameAr</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- BREADCRUMBS AREA END -->
<!-- Start page content -->
<section id="page-content" class="page-wrapper">
     
    <!-- FEATURED FLAT AREA START -->
    <div class="featured-flat-area pb-20">
        <div class="container">
            <div style="display: flex; flex-direction: column;">
                <div class="row" style="display: flex; flex-wrap: wrap; align-items: flex-end;">
                    @foreach (var item in Model)
                    { 
                            <div class="col-lg-12 col-sm-12 row" style="display: flex; align-items: flex-end;margin-top:40px">
                            <div class="col-lg-8 col-sm-12 pb-10"> 
                                <h2 class="en" style="text-transform:uppercase">@item.SubCategory.NameEn</h2>
                                <h2 class="ar">@item.SubCategory.NameAr</h2> 
                                <p class="en">@item.SubCategory.DescriptionEn</p>
                                <p class="ar">@item.SubCategory.DescriptionAr</p>
                                </div>
                            </div>

                           <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12" style="display: flex; align-items: flex-end;margin-bottom:40px">
                                <div style="padding:0"> 
                                     <img src="@item.SubCategory?.ImagePath" alt="" style="height:320px;object-fit:fill">
                                </div>
                            </div>

                            @foreach (var prod in item?.ProductList)
                            {
                                <div class="col-lg-2 col-md-2 col-sm-3 col-xs-6" style="display: flex; align-items: flex-end;margin-bottom:60px;">
                                    <div style="height:200px">
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@prod.Id"><img src="@prod.ImagePath" alt="" style="height:200px;"></a>
                                        <ul class="en" dir="ltr">
                                            <li>
                                                <p class="pt-15 en"><b>Model</b> : @Truncate(prod.Code, 60)</p>
                                            </li>
                                        </ul>
                                        <ul class="ar"  dir="rtl">
                                            <li>
                                                <p class="pt-15 ar"><b>موديل</b> :@Truncate(prod.Code, 60)</p>
                                            </li>
                                        </ul>
                                    </div> 
                                </div>
                            }
                        <div class="col-lg-1 col-md-1 col-sm-1 col-xs-1" style="display: flex; align-items: flex-end;margin-bottom:40px">
                             <a class="btnMore en" asp-controller="Product" asp-action="Index" asp-route-categoryId="@item.SubCategory?.Id">More</a>
                             <a class="btnMore ar" asp-controller="Product" asp-action="Index" asp-route-categoryId="@item.SubCategory?.Id">المزيد</a>
                         </div>  
                    }
                </div>
            </div>
        </div>
    </div> 
</section>
<!-- End page content -->
@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}
