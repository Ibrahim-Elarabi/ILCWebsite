                            <h5><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" target="_blank" title="View File" class="en">@item.TitleEn</a></h5>
                            <h5><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" target="_blank"  title="View File" class="ar">@item.TitleAr</a></h5>
                        </div>
                        <p class="en">@Truncate(item.DescriptionEn, 40)</p>
                        <p class="ar">@Truncate(item.DescriptionAr, 40)</p>
                    </div> 
                </article>
            </div>
        }
    </div>
     
    <br /> *@

    <div class="row" style="min-height:600px">
    @*     <div class="text-center">
                <h3 data-i18n="DOWNLOADS-CATALOGE" style="margin:30px auto"></h3>
            <hr />
        </div> *@

        @foreach (var item in Model)
        {
            <div class="col-md-4 col-sm-12 col-xs-12">
                <article class="recent-post-item">
                    <div class="recent-post-image">
                        <a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" target="_blank" title="View File"><img src="~/images/file.png" alt="" style="height:70px;object-fit:fill"></a>
                    </div>
                    <div class="recent-post-info">
                        <div class="recent-post-title-time">
                            <h5><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" target="_blank" title="View File" class="en">@item.TitleEn</a></h5>
                            <h5><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" target="_blank" title="View File" class="ar">@item.TitleAr</a></h5>
                        </div>
                        <p class="en">@Truncate(item.DescriptionEn, 40)</p>
                        <p class="ar">@Truncate(item.DescriptionAr, 40)</p>
                     </div>
                </article>
            </div>
        }
    </div>

    <br />
    <br />
    <br />

</div>

@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}







