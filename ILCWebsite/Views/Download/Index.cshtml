@model List<ILC.BL.Models.Admin.HomeSection.Downloads.DownloadVM>
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Index";
}<style>
     .bread-bg-1 {
         background: rgba(0, 0, 0, 0) url("images/bg/service.jpg") no-repeat scroll 0 0 / cover;
     }
</style>
<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs">
                    <h2 class="breadcrumbs-title" data-i18n="DOWNLOADS_RESOURSES"></h2>
                    <ul class="breadcrumbs-list">
                        <li><a asp-controller="Home" asp-action="index" data-i18n="Home"></a></li>
                        <li data-i18n="DOWNLOADS_RESOURSES"></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<br />
<br />
<div class="container">
     
    <div class="row">
        <div class="text-center">
            <h3 data-i18n="DOWNLOADS-TEMPLATES" style="margin:20px auto"></h3>
            <hr />
        </div>

        @foreach (var item in ViewBag.DownloadsTemplates)
        {  
            <div class="col-md-4">
                <article class="recent-post-item">
                    <div class="recent-post-image">
                        <a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" title="Download File"><img src="~/images/file.png" alt="" style="height:70px;object-fit:fill"></a>
                    </div>
                    <div class="recent-post-info">
                        <div class="recent-post-title-time">
                            <h5><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" title="Download File" class="en">@item.TitleEn</a></h5>
                            <h5><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" title="Download File" class="ar">@item.TitleAr</a></h5>
                        </div>
                        <p class="en">@Truncate(item.DescriptionEn, 40)</p>
                        <p class="ar">@Truncate(item.DescriptionAr, 40)</p>
                        @* <p> <a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item?.Id" target="_blank" title="View File" data-toggle="tooltip" style="color:#00f" data-i18n="VIEW_FILE"></a></p> *@
                    </div> 
                </article>
            </div>
        }
    </div>
     
    <br />

    <div class="row">
        <div class="text-center">
            <h3 data-i18n="DOWNLOADS-CATEGORIES" style="margin:30px auto"></h3>
            <hr />
        </div>

        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <article class="recent-post-item">
                    <div class="recent-post-image">
                        <a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" title="Download File"><img src="~/images/file.png" alt="" style="height:70px;object-fit:fill"></a>
                    </div>
                    <div class="recent-post-info">
                        <div class="recent-post-title-time">
                            <h5><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" title="Download File" class="en">@item.TitleEn</a></h5>
                            <h5><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" title="Download File" class="ar">@item.TitleAr</a></h5>
                        </div>
                        <p class="en">@Truncate(item.DescriptionEn, 40)</p>
                        <p class="ar">@Truncate(item.DescriptionAr, 40)</p>
                        @* <p> <a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item?.Id" target="_blank" title="View File" data-toggle="tooltip" style="color:#00f" data-i18n="VIEW_FILE"></a></p> *@
                    </div>
                </article>
            </div>
        }
    </div>

    <br />
    <br />
    <br />

</div>

@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}







