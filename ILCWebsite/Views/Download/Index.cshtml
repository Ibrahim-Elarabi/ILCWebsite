@model List<ILC.BL.Models.Admin.HomeSection.Downloads.DownloadVM>
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Index";
} 
<style>
    .btnView{
      /*   padding:10px; */
 /*        height:50px; */
        width:200px;
        border-radius:5px;
        margin-top:5px;
    }
</style>
<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70" >
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs">
                    <p class="breadcrumbs-title" data-i18n="DOWNLOADS-CATALOGE"></p>
                    <ul class="breadcrumbs-list">
                        <li><a asp-controller="Home" asp-action="index" data-i18n="Home"></a></li>
                        <li data-i18n="DOWNLOADS-CATALOGE"></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
 
<div class="container">

    @* <div class="row">
         <div class="text-center">
            <h3 data-i18n="DOWNLOADS-TEMPLATES" style="margin:20px auto"></h3>
            <hr />
        </div>

        @foreach (var item in ViewBag.DownloadsTemplates)
        {
            <div class="col-md-4 col-sm-12 col-xs-12">
                <article class="recent-post-item">
                    <div class="recent-post-image">
                        <a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" target="_blank" title="View File"><img src="~/images/file.png" alt="" style="height:70px;object-fit:fill"></a>
                    </div>
                    <div class="recent-post-info">
                        <div class="recent-post-title-time">
                            <h5><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" target="_blank" title="View File" class="en">@item.TitleEn</a></h5>
                            <h5><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" target="_blank"  title="View File" class="ar">@item.TitleAr</a></h5>
                        </div>
                        <p class="en">@Truncate(item.DescriptionEn, 40)</p>
                        <p class="ar">@Truncate(item.DescriptionAr, 40)</p>
                    </div> 
                </article>
            </div>
        }
    </div>
     
    <br /> *@

    <div class="row" style="min-height:600px">
    @*     <div class="text-center">
                <h3 data-i18n="DOWNLOADS-CATALOGE" style="margin:30px auto"></h3>
            <hr />
        </div> *@
        <div class="en">
            @foreach (var item in Model)
            {
                <div class="col-md-8 col-sm-12 col-xs-12 rtl" style="padding-top:50px;border-bottom:2px solid #ddd">
                    <div style="display:flex;align-items:flex-end">
                        <div class=" ">
                            <img src="@item.ImagePath" alt="" style="height:250px;width:200px;object-fit:fill">
                        </div>
                    </div>
                    <div><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" target="_blank" title="View File" class="btn btn-primary btnView"  data-i18n="VIEW_FILE"></a></div>
                    <div>
                        <br>
                        <div>
                            <h4>@item.TitleEn</h4>
                             <p class="en">@item.DescriptionEn</p>
                         </div>
                    </div>
                </div>
            }
        </div>
        <div class="ar">
            @foreach (var item in Model)
            {
                <div class="col-md-8 col-sm-12 col-xs-12 rtl" style="float:right;padding-top:50px;border-bottom:2px solid #ddd">
                    <div style="display:flex;align-items:flex-end">
                        <div class=" ">
                         <img src="@item.ImagePath" alt="" style="height:250px;width:200px;object-fit:fill">
                        </div>
                    </div>
                    <div><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" target="_blank" class="btn btn-primary btnView" data-i18n="VIEW_FILE"></a></div>
                    <div>
                        <br>
                        <div>
                             <h4> @item.TitleAr</h4>
                             <p class="ar">@item.DescriptionAr</p>
                        </div>
                    </div>
                </div>
            }
        </div> 
    </div>

    <br /> 

</div>  







