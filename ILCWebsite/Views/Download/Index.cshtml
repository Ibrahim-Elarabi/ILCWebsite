@model List<ILC.BL.Models.Admin.HomeSection.Downloads.DownloadVM>
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Index";
} 
<style>
    .btnView{ 
        width:200px;
        border-radius:4px;
        margin-top:5px;
    }

    /* Customize Bootstrap's btn btn-outline-secondary class */
    .custom-btn-outline-secondary {
        /* Background color when hovered */
        background-color: none; /* Customize this color as needed */
        color: #6c757d; /* Text color when hovered */
        border-color: #6c757d; /* Border color when hovered */
    }

        .custom-btn-outline-secondary:hover {
            background-color: #5a6268; /* Darker shade for hover effect */
            color: #ffffff; /* Ensure text color is readable on hover */
            border-color: #5a6268; /* Border color on hover */
        }

        .custom-btn-outline-secondary:focus,
        .custom-btn-outline-secondary.focus {
            box-shadow: 0 0 0 0.2rem rgba(107, 114, 128, 0.5); /* Customize the focus shadow */
            outline: none; /* Remove default focus outline */
        }

        .custom-btn-outline-secondary:disabled {
            opacity: 0.65; /* Customize opacity for disabled state */
            cursor: not-allowed; /* Change cursor for disabled state */
            background-color: #6c757d; /* Background color for disabled state */
            border-color: #6c757d; /* Border color for disabled state */
        }
</style>
<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70" >
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs">
                    <p class="breadcrumbs-title" data-i18n="DOWNLOADS-CATALOG"></p>
                    <ul class="breadcrumbs-list">
                        <li><a asp-controller="Home" asp-action="index" data-i18n="Home"></a></li>
                        <li data-i18n="DOWNLOADS-CATALOG"></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
 
<div class="container"> 
    <div class="row" style="min-height:600px"> 
        <div class="en">
            @foreach (var item in Model)
            {
                <div class="col-md-8 col-sm-12 col-xs-12 rtl" style="padding-top:50px;">
                    <div style="display:flex;align-items:flex-end">
                        <div class=" ">
                            <img src="@item.ImagePath" alt="" style="height:250px;width:200px;object-fit:fill">
                        </div>
                    </div>
                    <div><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" target="_blank" title="View File" class="btn custom-btn-outline-secondary btnView">Show Catalog</a></div>
                    <div>
                        <br>
                        <div>
                            <h4>@item.TitleEn</h4>
                             <p class="en">@item.DescriptionEn</p>
                         </div>
                    </div>
                </div>
            }
        </div>
        <div class="ar">
            @foreach (var item in Model)
            {
                <div class="col-md-8 col-sm-12 col-xs-12 rtl" style="float:right;padding-top:50px;">
                    <div style="display:flex;align-items:flex-end">
                        <div class=" ">
                         <img src="@item.ImagePath" alt="" style="height:250px;width:200px;object-fit:fill">
                        </div>
                    </div>
                    <div><a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item.Id" target="_blank" class="btn custom-btn-outline-secondary btnView">عرض الكاتالوج</a></div>
                    <div>
                        <br>
                        <div>
                             <h4> @item.TitleAr</h4>
                             <p class="ar">@item.DescriptionAr</p>
                        </div>
                    </div>
                </div>
            }
        </div> 
    </div> 

</div>  







