@model List<ILC.BL.Models.Admin.HomeSection.Downloads.DownloadVM>
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Index";
}
<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs">
                    <h2 class="breadcrumbs-title" data-i18n="DOWNLOADS_RESOURSES"></h2>
                    <ul class="breadcrumbs-list">
                        <li><a href="index.html" data-i18n="Home"></a></li>
                        <li data-i18n="DOWNLOADS_RESOURSES"></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<br />
<br />
<div class="container">
     
    <div class="row">
        <div class="text-center">
            <h3 data-i18n="DOWNLOADS-TEMPLATES" style="margin:20px auto"></h3>
            <hr />
        </div>

        @foreach (var item in ViewBag.DownloadsTemplates)
        {
            <div class="col-md-4">
                <article class="recent-post-item">
                    <div class="recent-post-image">
                        <a asp-controller="Home" asp-action="DownloadFile" asp-route-id="@item.Id"><img src="~/images/file.png" alt=""></a>
                    </div>
                    <div class="recent-post-info">
                        <div class="recent-post-title-time">
                            <h5><a asp-controller="Home" asp-action="DownloadFile" asp-route-id="@item.Id" class="en">@item.TitleEn</a></h5>
                            <h5><a asp-controller="Home" asp-action="DownloadFile" asp-route-id="@item.Id" class="ar">@item.TitleAr</a></h5>
                        </div>
                        <p class="en">@Truncate(item.DescriptionEn, 10)</p>
                        <p class="ar">@Truncate(item.DescriptionAr, 10)</p>
                    </div>

                    <p>
                        <a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item?.Id" target="_blank" class="material-tooltip-main btn-sm my-0 p-0 m-0 ml-1"
                           title="View File" data-toggle="tooltip">
                            <i style="width: 25px; padding: 2px;color:#777;font-size:20px" class="fas fa-eye"></i>
                        </a>
                    </p>
                </article>
            </div>
        }
    </div>
     
    <br />

    <div class="row">
        <div class="text-center">
            <h3 data-i18n="DOWNLOADS-CATEGORIES" style="margin:30px auto"></h3>
            <hr />
        </div>

        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <article class="recent-post-item">
                    <div class="recent-post-image">
                        <a asp-controller="Home" asp-action="DownloadFile" asp-route-id="@item.Id"><img src="~/images/file.png" alt=""></a>
                    </div>
                    <div class="recent-post-info">
                        <div class="recent-post-title-time">
                            <h5><a asp-controller="Home" asp-action="DownloadFile" asp-route-id="@item.Id" class="en">@item.TitleEn</a></h5>
                            <h5><a asp-controller="Home" asp-action="DownloadFile" asp-route-id="@item.Id" class="ar">@item.TitleAr</a></h5>
                        </div>
                        <p class="en">@Truncate(item.DescriptionEn, 10)</p>
                        <p class="ar">@Truncate(item.DescriptionAr, 10)</p>
                    </div>
                    <p>
                        <a asp-controller="Download" asp-action="ViewFile" asp-route-id="@item?.Id" target="_blank" class="material-tooltip-main btn-sm my-0 p-0 m-0 ml-1"
                           title="View File" data-toggle="tooltip">
                            <i style="width: 25px; padding: 2px;color:#777;font-size:20px" class="fas fa-eye"></i>
                        </a>
                    </p>
                </article>
            </div>
        }
    </div>

    <br />
    <br />
    <br />

</div>

@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}







