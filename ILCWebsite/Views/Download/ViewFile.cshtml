@model ILC.BL.Models.Admin.HomeSection.Downloads.DownloadVM
@{
    ViewData["Title"] = "ViewFile";
}
<br /> 
<style>
    /* Style for large screens */
    #pdfViewer {
        width: 100%;
        height: 900px;
    }

    /* Style for smaller screens */
    @@media (max-width: 768px) {
        #pdfViewer {
            height: 100vh;
            width: 100%;
        }
    } 
</style> 
<div style="margin: 20px; padding: 20px;">
    <iframe id="pdfViewer" src="@Model.PdfPath" type="application/pdf" style="width: 100%; height: 900px;" title="PDF Viewer" frameborder="0"></iframe>
</div>



