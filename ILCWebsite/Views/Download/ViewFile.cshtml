@model ILC.BL.Models.Admin.HomeSection.Downloads.DownloadVM
@{
    ViewData["Title"] = "ViewFile";
}
<br /> 
<style> 
    #pdfViewer {
        width: 100%;
        height: 700px; 
        margin: 30px auto; 
        margin-bottom: 10px;
    }
       
    @@media (max-width: 768px) {
        #pdfViewer {
            width: 100%;
            height: 400px; 
            margin: 0px auto; 
            margin-bottom:10px;
        } 
         
    } 
</style> 
<div class="text-center">
    <iframe  id="pdfViewer" src="@Model.PdfPath" type="application/pdf" title="PDF Viewer" frameborder="0"></iframe>
</div> 


