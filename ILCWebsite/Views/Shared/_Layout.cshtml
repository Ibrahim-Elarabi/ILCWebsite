@using System.Security.Claims;
@{
    var identity = (ClaimsIdentity)User.Identities.LastOrDefault();
    //TODO: use ibrahem services  var LoggedUserId = identity.FindFirst("LoggedUserId")?.Value ?? "LoggedUserId";
    var UserName = identity.FindFirst("Name")?.Value ?? "User name";
    var Email = identity.FindFirst("Email")?.Value ?? "Email";
    
    var lst = _unitOfWork._categoryRepo.Find(c => c.ParentCategoryId == null).Include(d=>d.SubCategories);
    var blogs = _unitOfWork._blogHomeRepo.GetAll().Where(d=>d.AppearInHome == true).OrderByDescending(d=>d.CreationDate).Take(3).ToList();

    var categories = _mapper.Map<List<ILC.BL.Models.Admin.Categories.CategoryVM>>(lst);
}
