    @functions {
        public string Truncate(string input, int maxLength)
        {
            if (input.Length > maxLength)
            {
                return input.Substring(0, maxLength) + "...";
            }
            return input;
        }
    }

    <!-- Body main wrapper end -->
    <!-- Placed js at the end of the document so the pages load faster -->
    <!-- jquery latest version -->
    <script src="~/js/vendor/jquery-3.1.1.min.js"></script>
    <!-- Bootstrap framework js -->
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/lib/js/jquery.nivo.slider.js"></script> 
    <!-- ajax-mail js -->
    <script src="~/js/ajax-mail.js"></script>
    <!-- All js plugins included in this file. -->
    <script src="~/js/plugins.js"></script>
    <script src="~/js/all.min.js"></script>
    <!-- Main js file that contents all jQuery plugins activation. -->
    <script src="~/js/main.js"></script>
    <!-- language switch script -->
    <script src="~/js/script.js"></script>
    <script src="~/js/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/customscript/site.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lightbox2/2.11.3/js/lightbox.min.js"></script>

    <script>
        $("document").ready(function () {
            $('#AdminDivLoader').hide();
        });  
        document.addEventListener('DOMContentLoaded', (event) => {
            const sliderWrapper = document.querySelector('.slider-wrapper');
            const images = document.querySelectorAll('.slider-image');

            // Duplicate images to create a seamless loop
            images.forEach(image => {
                const clone = image.cloneNode(true);
                sliderWrapper.appendChild(clone);
            });

            //Adjust the width of the slider wrapper dynamically based on the number of images
            const totalImages = sliderWrapper.querySelectorAll('.slider-image').length;
            sliderWrapper.style.width = `${totalImages * 32}%`;
        });


    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

