@model List<ILC.BL.Models.Admin.Categories.CategoryVM>
<div class="container">
    <div class="row">
        <div class="col-xs-12">
            <div class="mobile-menu">
                <nav id="dropdown">
                    <ul>
                        <li>
                            <a data-i18n="Home" href="/">Home</a>
                        </li>
                        <li>
                            <a data-i18n="AboutUs" asp-controller="Home" asp-action="AboutUs"></a>
                        </li>
                        <li>
                            <a asp-controller="Category" asp-action="index" data-i18n="Products">Products</a>
                            <ul>
                                <div id="accordion-mobile" >

                                    @foreach (var item in Model)
                                    {
                                    <li style="margin-left: 0px;">
                                        <div class="card">
                                            <div class="card-header" id="headingOne">
                                                <h5 class="mb-0 menu-btn en" style="overflow:hidden">
                                                    <button class="btn btn-link" data-toggle="collapse"
                                                            data-target="#collapseOne-mob-en-@item.Id" aria-expanded="true"
                                                            aria-controls="collapseOne">
                                                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@item.Id">
                                                                 @item.NameEn
                                                        </a>
                                                    </button>
                                                </h5>
                                                <h5 class="mb-0 menu-btn ar" style="overflow:hidden">
                                                    <button class="btn btn-link" data-toggle="collapse"
                                                            data-target="#collapseOne-mob-ar-@item.Id" aria-expanded="true"
                                                            aria-controls="collapseOne">
                                                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@item.Id">
                                                                @item.NameAr
                                                        </a>
                                                    </button>
                                                </h5>
                                            </div>

                                             @*<div id="collapseOne-mob-en-@item.Id" class="collapse"
                                                 aria-labelledby="headingOne" data-parent="#accordion-mobile">
                                                <div class="card-body">
                                                    <ul>
                                                            @foreach (var subCategory in item?.SubCategories)
                                                            {
                                                            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@subCategory.Id">
                                                            <li class=" menu-btn">
                                                                        @subCategory.NameEn
                                                            </li>
                                                            </a>
                                                            }
                                                    </ul>
                                                </div>
                                            </div>
                                            <div id="collapseOne-mob-ar-@item.Id" class="collapse"
                                                 aria-labelledby="headingOne" data-parent="#accordion-mobile">
                                                <div class="card-body">
                                                    <ul>
                                                            @foreach (var subCategory in item?.SubCategories)
                                                            {
                                                            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@subCategory.Id">
                                                            <li class=" menu-btn">
                                                                        @subCategory.NameAr
                                                            </li>
                                                            </a>
                                                            }

                                                    </ul>
                                                </div>
                                            </div> *@
                                        </div>
                                    </li>
                                    }

            </div>
            </ul>
            </li>
            <li><a asp-controller="Service" asp-action="index" data-i18n="Services"></a></li>
            <li><a asp-controller="Download" asp-action="index" data-i18n="Cataloge"></a></li>
            <li><a asp-controller="Blog" asp-action="index" data-i18n="Blogs"></a></li>
            <li><a asp-controller="Home" asp-action="ContactUs" data-i18n="ContactUs"></a></li>

            <li class="ar" style="cursor:pointer !important"><a onclick=" changeLanguage('en')" style=" color:#e2a165">EN</a></li>
            <li class="en" style="cursor:pointer !important"><a onclick="changeLanguage('ar')" style=" color:#e2a165">AR</a></li>

            </ul>
            </nav>
        </div>
    </div>
</div>
</div>