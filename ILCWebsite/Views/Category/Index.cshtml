@model List<ILC.BL.Models.Admin.Categories.CategoryVM>
@{
    Layout = "_Layout";
    var categoryType = ViewBag.CategoryType;
}
<style>
  img:hover {
        transform: scale(1.2);
    }

    .image-container {
        position: relative;
        display: inline; 
    }

    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0); 
      transition: background-color 0.3s ease; 
    }

    .image-container:hover .overlay {
        background-color: rgba(0, 0, 0, 0.5); 
    } 
     
     .image-container img {
        display: block;
        width: 100%;
        height: auto;
    }

    .categoryCard:hover {
        transform: scale(1.01); 
    } 
</style>
<!-- BREADCRUMBS AREA START -->
<div class="breadcrumbs-area bread-bg-1 bg-opacity-black-70">
    <div class="container">
        <div class="row">
            <div class="col-xs-12">
                <div class="breadcrumbs">
                    @if (ViewBag.MainCategory == true)
                    {
                        <p class="breadcrumbs-title" data-i18n="Categories"></p>
                    }
                    else
                    {
                        <p class="breadcrumbs-title en">@ViewBag.NameEn</p>
                        <p class="breadcrumbs-title ar">@ViewBag.NameAr</p>
                    }
                    <ul class="breadcrumbs-list">
                        <li><a asp-controller="Home" asp-action="Index" data-i18n="Home"></a></li>
                        <li data-i18n="Categories"></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- BREADCRUMBS AREA END -->
<!-- Start page content -->
<section id="page-content" class="page-wrapper">
    <div class="featured-flat-area pt-70 pb-60">
        <div class="container">
            @if (ViewBag.MainCategory == false)
            {
                <div class="en">
                    <h3 class="en">@ViewBag.NameEn</h3>
                    <h3 class="ar">@ViewBag.NameAr</h3>
                    <p style="font-size:18px" class="en">@ViewBag.DescriptionEn</p>
                    <p style="font-size:18px" class="ar">@ViewBag.DescriptionAr</p>
                    <br>
                    <br>
                </div>
                <div class="ar text-right">
                    <h3 class="en">@ViewBag.NameEn</h3>
                    <h3 class="ar">@ViewBag.NameAr</h3>
                    <p style="font-size:18px" class="en">@ViewBag.DescriptionEn</p>
                    <p style="font-size:18px" class="ar">@ViewBag.DescriptionAr</p>
                    <br>
                    <br>
                </div>
            }
            <div class="featured-flat">
                <div class="row">
                    @if (ViewBag.MainCategory == true)
                    {
                        @foreach (var item in Model)
                        {
                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
                                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@item.Id">
                                    <div class="service-item">
                                        <div class="service-item-image">
                                            <div class="image-container">
                                                <img src="@item.ImagePath" alt="" style="height:200px;object-fit:cover">
                                                <div class="overlay"></div>
                                            </div>
                                        </div>
                                        <div class="service-item-info rtl" style="height:90px;margin-top:-10px;">
                                            <p class="en" style="font-size:16px">@Truncate(item.NameEn, 50)</p>
                                            <p class="ar" style="font-size:16px">@Truncate(item.NameAr, 50)</p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12">
                                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@item.Id">
                                    <div class="service-item">
                                        <div class="service-item-image">
                                            <div class="image-container">
                                                <img src="@item.ImagePath" alt="" style="height:200px;object-fit:cover">
                                                <div class="overlay"></div>
                                            </div>
                                        </div> 
                                        <div class="service-item-info rtl" style="height:90px;margin-top:-10px;">
                                            <p class="en" style="font-size:16px">@Truncate(item.NameEn, 50)</p>
                                            <p class="ar" style="font-size:16px">@Truncate(item.NameAr, 50)</p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    }

                </div>


            </div>
        </div>

    </div>

</section>

@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}
<!-- End page content -->
