@model List<ILC.BL.Models.Admin.HomeSection.Inquirys.InquiryVM>
@using Microsoft.Extensions.Localization
@using ILCWebsite.Models.Resources
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "List";
}

<!-- Custom styles for this page -->
<link href="vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
<div class="content-wrapper">
    <h4 class="fancy-title">Inquiries Table</h4>
    <div class="container-fluid">
        <!-- DataTales Example -->
        <div class="card shadow mb-4"> 
            <div class="card-body">
                <div class="table-responsive"> 
                    <table class="table table-bordered table-sm" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Name</th>
                                <th>Last Name</th>
                                <th>Email</th>
                            @*     <th>Phone</th>
                                <th>Country</th>  *@
                                <th>Subject</th> 
                                <th class="text-center">Seen?</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead> 
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td style ="min-width:30px" class="text-center">@item?.Id</td>
                                    <td style="min-width:100px">@item?.Name</td>
                                    <td style="min-width:100px">@item?.LastName</td>
                                    <td style="min-width:150px">@item?.Email</td>
                                @*     <td style="min-width:120px">@item?.CountryCode - @item?.Phone</td>
                                    <td style="min-width:120px">@item?.Country</td> *@
                                    <td style="min-width:120px">@item?.Subject</td>
                                    <td style="min-width:50px"  class="text-center">
                                    @if (item?.IsSeen == true) 
                                        {
                                            <i class="fas fa-check-circle text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-times-circle text-danger"></i>
                                        }
                                    </td>
                                    <td style="min-width:250px" class="text-center">
                                        <a class="btn btn-primary me-auto" href="/Admin/Inquiry/Details/@item?.Id"> Details</a>
                                         <a class="btn btn-success me-auto" href="/Product/Details/@item?.productId"> Product</a>
                                        <button class="btn btn-danger me-auto" onclick="Delete(@item?.Id,'/Admin/Inquiry/Delete')"> <img src="~/images/icons/delete.png" alt="edit" style="height:15px; margin-bottom:3px" />Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>
@section Scripts {
    <script src="~/js/npm_axios_dist_axios.min.js"></script>
    <script src="~/customscript/sahreddelete.js"></script>
}