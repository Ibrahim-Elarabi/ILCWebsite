@model ILC.BL.Models.Admin.HomeSection.Inquirys.InquiryVM
@using Microsoft.Extensions.Localization
@using ILCWebsite.Models.Resources
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "List";
}

<div class="content-wrapper">
    <h4 class="fancy-title">Inquiry Details</h4>
    <div class="page-header text-right mb-2">
        <a class="btn btn-primary" asp-controller="Inquiry" asp-action="index"><img src="~/images/icons/left-arrow.png" alt="edit" style="height:15px; margin-bottom:3px" /> Back to list</a>
    </div> 
    <div class="row">
        <div class="col-md-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <table class="table table-striped  table-bordered" width="100%" cellspacing="0">
                        <tr>
                            <td style="font-weight:500;width:15%;text-align:center">Id  </td>
                            <td>@Model?.Id</td>
                        </tr>
                        <tr>
                            <td style="font-weight:500;width:15%;text-align:center">Name  </td>
                            <td>@Model?.Name</td>
                        </tr>
                        <tr>
                            <td style="font-weight:500;width:15%;text-align:center">Last Name </td>
                            <td>@Model?.LastName</td>
                        </tr>
                        <tr>
                            <td style="font-weight:500;width:15%;text-align:center">Email </td>
                            <td>@Model?.Email</td>
                        </tr>
                        <tr>
                            <td style="font-weight:500;width:15%;text-align:center">Phone </td>
                            <td>@Model?.CountryCode - @Model?.Phone</td>
                        </tr>
                        <tr>
                            <td style="font-weight:500;width:15%;text-align:center">Country </td>
                            <td>@Model?.Country</td>
                        </tr>
                        <tr>
                            <td style="font-weight:500;width:15%;text-align:center">City </td>
                            <td>@Model?.City</td>
                        </tr> 
                        <tr>
                            <td style="font-weight:500;width:15%;text-align:center">Date </td>
                            <td> @Model?.CreationDate.GetValueOrDefault().ToString("dd-MM-yyyy HH:mm")</td>
                        </tr> 
                        <tr>
                            <td style="font-weight:500;width:15%;text-align:center">Subject </td>
                            <td> @Model?.Subject</td>
                        </tr> 
                        <tr>
                            <td style="font-weight:500;width:15%;text-align:center">Message </td>
                            <td> @Model?.Message</td>
                        </tr>  
                    </table>
                 </div>
            </div>
        </div>
    </div>
</div>  