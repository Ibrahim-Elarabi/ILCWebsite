@model IEnumerable<ILC.BL.Models.Admin.HomeSection.Achievements.AchievementVM> 
@using Microsoft.Extensions.Localization
@using ILCWebsite.Models.Resources
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "List";
}

<!-- Custom styles for this page -->
<link href="vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
<div class="content-wrapper">
    <h4 class="fancy-title">Achievements Table</h4>
    <div class="container-fluid">
        <!-- DataTales Example -->
        <div class="card shadow mb-4"> 
            <div class="card-body">
                <div class="table-responsive">

                    <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr> 
                                <th>English title</th>
                                <th>Arabic title</th>
                                <th>Value</th> 
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead> 
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item?.TitleEn</td>
                                    <td>@item?.TitleAr</td>
                                    <td>@item?.Value</td>
                                    <td style="min-width:220px" class="text-center">
                                        <a class="btn btn-primary me-auto" href="/Admin/Achievement/Edit/@item?.Id"><img src="~/images/icons/edit.png" alt="edit" style="height:15px; margin-bottom:3px" /> Edit</a>
                                        <button class="btn btn-danger me-auto" onclick="Delete(@item?.Id,'/Admin/Achievement/Delete')">
                                            <img src="~/images/icons/delete.png" alt="edit" style="height:15px; margin-bottom:3px" />
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>
@section Scripts {
    <script src="~/js/npm_axios_dist_axios.min.js"></script>
    <script src="~/customscript/sahreddelete.js"></script>
}