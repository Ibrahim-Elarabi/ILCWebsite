@model ILC.BL.Models.Admin.HomeSection.AboutUs.EditAboutUsHomeVM
@{
    Layout = "_AdminLayout";
}
<div class="content-wrapper">
    <h4 class="fancy-title">Edit About us section</h4> 
    <form id="formAdmin" class="forms-sample">
        <div class="row">
            <div class="col-lg-12 col-md-12 grid-margin stretch-card">
                <div class="page-header text-right mb-2">
                    <a class="btn btn-primary" asp-controller="AboutUsHome" asp-action="index">
                        <img src="~/images/icons/left-arrow.png" alt="edit" style="height:15px; margin-bottom:3px" />
                        Back to details
                    </a>
                </div>
                <div class="card">
                    <div class="card-body">
                        <div class="row">

                            <div class="col-md-6 col-sm-12">
                                <div class="form-group">
                                    <label asp-for="TitleEn">Title En : </label>
                                    <input type="text" asp-for="TitleEn" class="form-control" placeholder="Title En" />
                                    <span asp-validation-for="TitleEn" style="font-size:.9em; color:red"></span>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-12">
                                <div class="form-group">
                                    <label asp-for="TitleEn">Title Ar : </label>
                                    <input type="text" asp-for="TitleAr" class="form-control" placeholder="Title Ar" />
                                    <span asp-validation-for="TitleAr" style="font-size:.9em; color:red"></span>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-12">
                                <div class="form-group">
                                    <label asp-for="TextEn">Text En: </label>
                                    <textarea type="text" asp-for="TextEn" class="form-control" placeholder="Title En" rows="8"></textarea>
                                    <span asp-validation-for="TextEn" style="font-size:.9em; color:red"></span>
                                </div>
                            </div>

                            <div class="col-md-6 col-sm-12">
                                <div class="form-group">
                                    <label asp-for="TextAr">Text Ar: </label>
                                    <textarea type="text" asp-for="TextAr" class="form-control" placeholder="Title Ar" rows="8"></textarea>
                                    <span asp-validation-for="TextAr" style="font-size:.9em; color:red"></span>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-12">
                                <div class="form-group">
                                    <label asp-for="Order">Order:</label>
                                    <input type="number" asp-for="Order" class="form-control" placeholder="Order">
                                    <span asp-validation-for="Order" style="font-size:.9em; color:red"></span>
                                </div>
                            </div>

                        </div>
                        <div class="text-right">
                            <button type="submit" class="btn btn-primary me-auto">
                                <img src="~/images/icons/check.png" alt="edit" style="height:15px; margin-bottom:3px" />
                                Save
                            </button>
                            <button type="button" class="btn btn-danger me-auto" onclick="clearForm()">
                                <img src="~/images/icons/circular.png" alt="edit" style="height:15px; margin-bottom:3px" />
                                Clear
                            </button>
                        </div>
                        @* <input type="hidden" value="@Model?.ImagePath" name="ImagePath" /> *@
                        <input type="hidden" value="/Admin/AboutUsHome/Edit" id="URL" />
                        <input type="hidden" value="@Model?.Id" name="Id" />
                    </div>
                </div>
            </div>  
        </div>
    </form>
</div>
@section Scripts {
    <script src="~/js/npm_axios_dist_axios.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/customscript/shared.js"></script>
    <script>
        function clearForm() {
            document.getElementById("formAdmin").reset(); 
        }
    </script>
} 