@model List<ILC.BL.Models.Admin.HomeSection.AboutUs.AboutUsHomeVM>
@using Microsoft.Extensions.Localization
@using ILCWebsite.Models.Resources
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "List";
}
<!-- Custom styles for this page -->
<link href="vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
<div class="content-wrapper">
    <h4 class="fancy-title">AboutUs Table</h4>
    <div class="container-fluid">
        <!-- DataTales Example -->
        <div class="card shadow mb-4">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-sm" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>  
                                <th>Order</th>
                                <th>Title Ar</th>
                                <th>Title En</th>
                                <th>Description Ar</th>
                                <th>Description En</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td style="min-width:30px"> @item?.Order</td>
                                    <td style="min-width:120px">@item?.TitleAr</td>
                                    <td style="min-width:120px">@item?.TitleEn</td>
                                    <td style="min-width:200px"> @Truncate(item?.TextAr, 150)</td>
                                    <td style="min-width:200px"> @Truncate(item?.TextEn, 150)</td>
                                    <td style="min-width:100px">
                                        <a class="btn btn-primary me-auto" href="/Admin/AboutUsHome/Edit/@item?.Id">
                                            <img src="~/images/icons/edit.png" alt="edit" style="height:15px; margin-bottom:3px" />
                                            Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/npm_axios_dist_axios.min.js"></script> 
}
@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input?.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}