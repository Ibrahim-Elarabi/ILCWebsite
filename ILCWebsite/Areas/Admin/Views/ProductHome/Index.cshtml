@model List<ILC.BL.Models.Admin.HomeSection.Product.ProductHomeVM>
@using Microsoft.Extensions.Localization
@using ILCWebsite.Models.Resources
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "List";
}
<!-- Custom styles for this page -->
<link href="vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
<div class="content-wrapper">
    <h4 class="fancy-title">Products Table</h4>
    <div class="container-fluid">

        <!-- DataTales Example -->
        <div class="card shadow mb-4">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-sm" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Image</th>
                                <th>Code</th>
                                <th>Arabic title</th>
                                <th>English title</th> 
                                <th>Appear in sub category</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@item?.Id</td>
                                    <td><img class="mb-2" src="@item.ImagePath" style="max-width:100px;max-height:100px" /></td>
                                    <td>@item?.Code</td>
                                    <td>@item?.TitleAr</td>
                                    <td>@item?.TitleEn</td> 
                                    <td class="text-center"> 
                                        @if (item?.IsAppearInHome == true)
                                        {
                                            <i class="fas fa-check-circle text-success"></i>
                                        } 
                                    </td> 
                                    <td class="text-center">
                                        <a class="btn btn-primary me-auto" href="/Admin/ProductHome/Edit/@item?.Id">
                                            <img src="~/images/icons/edit.png" alt="edit" style="height:15px; margin-bottom:3px" />
                                            Edit
                                        </a>
                                        <button class="btn btn-danger me-auto" onclick="Delete(@item?.Id,'/Admin/ProductHome/Delete')">
                                            <img src="~/images/icons/delete.png" alt="edit" style="height:15px; margin-bottom:3px" />
                                            Delete
                                        </button>
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
    <!-- /.container-fluid -->

</div>
<!-- End of Main Content -->
@section Scripts {
    <script src="~/js/npm_axios_dist_axios.min.js"></script>
    <script src="~/customscript/sahreddelete.js"></script>
}

@functions {
    public string Truncate(string input, int maxLength)
    {
        if (input.Length > maxLength)
        {
            return input.Substring(0, maxLength) + "...";
        }
        return input;
    }
}
