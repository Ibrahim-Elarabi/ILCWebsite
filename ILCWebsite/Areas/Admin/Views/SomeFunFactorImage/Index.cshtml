@model List<ILC.BL.Models.Admin.HomeSection.SomeFunFactorImages.SomeFunFactorImageVM>
@using Microsoft.Extensions.Localization
@using ILCWebsite.Models.Resources
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "List";
} 
<!-- Custom styles for this page -->
<link href="vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
<div class="content-wrapper">
    <h4 class="fancy-title">FunFactor Images Table</h4>
    <div class="container-fluid">
        <!-- DataTales Example -->
        <div class="card shadow mb-4"> 
            <div class="card-body">
                <div class="table-responsive"> 
                    <table class="table table-bordered table-sm" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                @* <th>Id</th> *@
                                <th>Order</th>
                                <th>Image</th>
                                <th>Actions</th>
                            </tr>
                        </thead> 
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    @* <td style="min-width:50px" class="text-center">@item?.Id</td> *@
                                    <td style="min-width:50px">@item?.Order</td>
                                    <td style="min-width:100px"><img class="mb-2" src="@item.ImagePath" style="max-width:100px;max-height:100px" /></td>
                                    <td style="min-width:220px" class="text-center">
                                        <a class="btn btn-primary me-auto" href="/Admin/SomeFunFactorImage/Edit/@item?.Id"><img src="~/images/icons/edit.png" alt="edit" style="height:15px; margin-bottom:3px" /> Edit</a>
                                        <button class="btn btn-danger me-auto" onclick="Delete(@item?.Id,'/Admin/SomeFunFactorImage/Delete')"><img src="~/images/icons/delete.png" alt="edit" style="height:15px; margin-bottom:3px" /> Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/npm_axios_dist_axios.min.js"></script>
    <script src="~/customscript/sahreddelete.js"></script>
} 

