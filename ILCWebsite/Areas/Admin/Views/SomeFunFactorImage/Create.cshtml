@model ILC.BL.Models.Admin.HomeSection.SomeFunFactorImages.CreateSomeFunFactorImageVM
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create";
}
<div class="content-wrapper">
    <h4 class="fancy-title">Create FunFactor Image</h4>
     <div class="page-header text-right">
        <a class="btn btn-primary mb-2" asp-controller="SomeFunFactorImage" asp-action="index">Back to list</a>
    </div>
    <form id="formAdmin" class="forms-sample">
        <div class="row">
            <div class="col-lg-8 col-md-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <div class="row">  
                            <div class="col-lg-6 col-md-12">
                                <div class="form-group">
                                    <label asp-for="Order">Order : </label>
                                    <input type="number" asp-for="Order" class="form-control" placeholder="Order" />
                                    <span asp-validation-for="Order" style="font-size:.9em; color:red"></span>
                                </div>
                            </div> 
                        </div>

                        <div class="text-right">
                            <button type="submit" class="btn btn-primary me-auto"><img src="~/images/icons/check.png" alt="edit" style="height:15px; margin-bottom:3px" /> Save</button>
                            <button type="button" class="btn btn-danger me-auto" onclick="clearForm()"><img src="~/images/icons/circular.png" alt="edit" style="height:15px; margin-bottom:3px" /> Clear</button>
                        </div>
                        <input type="hidden" value="/Admin/SomeFunFactorImage/Create" id="URL" />
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-12  grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="form-group">
                                <label asp-for="ImagePath" style="color:#00f">Upload Image (200 * 300 H)</label>
                                <input type="file" asp-for="Image" class="file-upload-default" />
                                <span asp-validation-for="Image" style="font-size:.9em; color:red"></span>
                            </div>
                        </div> 
                        @await Html.PartialAsync("_PreviewImage", Model?.ImagePath) 
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts{
    <script src="~/js/npm_axios_dist_axios.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/customscript/shared.js"></script>
    <script>
        function clearForm() {
            document.getElementById("formAdmin").reset();
            var imagePreview = document.getElementById("imagePreview");
            imagePreview.src = "";
        }
    </script>
} 
 