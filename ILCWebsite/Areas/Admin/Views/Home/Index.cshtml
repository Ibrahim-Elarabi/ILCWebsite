@model List<ILC.BL.Models.Admin.HomeSection.HomeAdminVM>
@{
    Layout = "_AdminLayout";
}

<style>
    .service-item {
        background-color: #fff; /* Default background color */
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
        text-align: center; /* Center content horizontally */
        color: #999;
    }

    /*     .service-item-info {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }
        /* Define different background colors for odd and even items
         .service-item:nth-child(odd) {
            background-color: #f0f0f0;
        }*/

    /* .service-item:nth-child(even) {
            background-color: #eaeaea;
        }  */

    /* Adjust text alignment for RTL languages */
    /*     .rtl {
            text-align: center;
        } */

</style>


<div class="featured-flat-area">
    <div class="container">
        <div class="featured-flat">
            <div class="row">
                <div class="col-md-12 text-center my-4">
                    <h5 style="color:#999">YOUR <span style="color:#080">ILC </span>WEBSITE STATISTICS</h5>
                </div>
                @foreach (var item in Model)
                {
                    <div class="col-md-4 col-sm-6 col-xs-12">
                        <div class="row service-item m-3">
                            <div class="col-md-6 text-left">
                                <h4>@item.Count</h4>
                                <span>@item.Name</span>
                            </div>
                            <div class="col-md-6 text-right" style="direction:rtl">
                                <div style="padding:10px;border-radius:7px;background-color:#f1f1f1;color:#aa0;display:inline-block">
                                   <i class="fas fa-fw @item.Icon" style=""></i>
                            </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>