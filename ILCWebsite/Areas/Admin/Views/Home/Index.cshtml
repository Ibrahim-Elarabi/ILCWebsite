@model List<ILC.BL.Models.Admin.HomeSection.HomeAdminVM>
@{
    Layout = "_AdminLayout";
}

<style>
    .Scard {
        background-color: #fff;
        width: 100%;
        margin-bottom:20px;
        padding: 20px;
        border-radius: 5px;
        overflow: hidden;
        box-shadow: 0 18px 42px 0 rgba(28, 30, 35, 0.15);
        transition: transform .5s ease;
    } 
</style>


<div class="featured-flat-area">
    <div class="container">
        <div class="featured-flat">
            <div class="row">
                <div class="col-md-12 text-center my-4">
                    <h5 style="color:#999">YOUR <span style="color:#080">ILC </span>WEBSITE STATISTICS</h5>
                </div>
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12 row" style="margin:0">
                        <div class="Scard row">
                            <div class="col-md-8 text-left"> 
                                <h4>@item.Count</h4>
                                <span>@item.Name</span> 
                            </div>
                            <div class="col-md-4 text-right" style="direction:rtl">
                                <div style="padding:10px;border-radius:7px;background-color:#f1f1f1;color:#777;display:inline-block">
                                    <i class="fas fa-fw @item.Icon" style=""></i>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>