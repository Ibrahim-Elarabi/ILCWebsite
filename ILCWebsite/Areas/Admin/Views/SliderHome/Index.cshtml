@model List<ILC.BL.Models.Admin.HomeSection.Slider.SliderHomeVM>
@using Microsoft.Extensions.Localization
@using ILCWebsite.Models.Resources
@inject IStringLocalizer<HomeResource> HomeResource
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "List";
}
<div class="content-wrapper">
    <h4 class="fancy-title">Slider Details</h4> 
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-8 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body"> 
                        <table class="table table-striped  table-bordered" width="100%" cellspacing="0">
                            <tr>
                                <td style="font-weight:500;width:20%;text-align:center">Title En</td>
                                <td>@item?.FirstHeadTextEn</td>
                            </tr>
                            <tr>
                                <td style="font-weight:500;width:20%;text-align:center">Title Ar</td>
                                <td>@item?.FirstHeadTextAr</td>
                            </tr>
                            <tr>
                                <td style="font-weight:500;width:20%;text-align:center">Sub-Title En</td>
                                <td>@item?.SecondtHeadTextEn</td>
                            </tr>
                            <tr>
                                <td style="font-weight:500;width:20%;text-align:center">Sub-Title Ar </td>
                                <td>@item?.SecondHeadTextAr </td>
                            </tr>
                            <tr>
                                <td style="font-weight:500;width:20%;text-align:center">Description En </td>
                                <td>@item?.ParagraphEn</td>
                            </tr>
                            <tr>
                                <td style="font-weight:500;width:20%;text-align:center">Description Ar </td>
                                <td>@item?.ParagraphAr</td>
                            </tr>
                        </table> 
                         
                        <div class="text-right mt-2">
                            <a class="btn btn-primary me-auto" href="/Admin/SliderHome/Edit/@item?.Id"><img src="~/images/icons/edit.png" alt="edit" style="height:15px; margin-bottom:3px" /> Edit</a>
                            @* <button class="btn btn-danger me-auto" onclick="Delete(@item?.Id,'/Admin/SliderHome/Delete')"> Delete</button> *@
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <img class="mb-2" src="@item.ImagePath" style="max-width:100%" />
                    </div>
                </div>
            </div>
        }

    </div>
</div>
@section Scripts {
    <script src="~/js/npm_axios_dist_axios.min.js"></script>
    <script src="~/customscript/sahreddelete.js"></script>
} 