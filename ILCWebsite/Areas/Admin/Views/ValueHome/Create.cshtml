@model ILC.BL.Models.Admin.HomeSection.ValuesHome.CreateValueHomeVM

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create";
}
<div class="content-wrapper">
    <h4 class="fancy-title">Create Value</h4>
    <div class="page-header text-right mb-2">
        <a class="btn btn-primary" asp-controller="ValueHome" asp-action="index"><img src="~/images/icons/left-arrow.png" alt="edit" style="height:15px; margin-bottom:3px" /> Back to list</a>
    </div>
    <form id="formAdmin" class="forms-sample">
        <div class="row"> 
            <div class="col-md-8 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="TitleEn">Title En : </label>
                                    <input type="text" asp-for="TitleEn" class="form-control" placeholder="Title En" />
                                    <span asp-validation-for="TitleEn" style="font-size:.9em; color:red"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="TitleEn">Title Ar : </label>
                                    <input type="text" asp-for="TitleAr" class="form-control" placeholder="Title Ar" />
                                    <span asp-validation-for="TitleAr" style="font-size:.9em; color:red"></span>
                                </div>
                            </div> 
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="DescriptionEn">Description En :</label>
                                    <textarea type="text" asp-for="DescriptionEn" class="form-control" id="DescriptionEn"
                                              placeholder="Description En" rows="5"></textarea>
                                    <span asp-validation-for="DescriptionEn" style="font-size:.9em; color:red"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="DescriptionAr">Description Ar :</label>
                                    <textarea type="text" asp-for="DescriptionAr" class="form-control" id="DescriptionAr"
                                              placeholder="Description Ar" rows="5"></textarea>
                                    <span asp-validation-for="DescriptionAr" style="font-size:.9em; color:red"></span>
                                </div>
                            </div> 
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label" for="pref-search">Is Appear In Home :</label>
                                    <input type="checkbox"  name="AppearInHome" value="true" />
                                </div>
                            </div>
                        </div>
                        <div class="text-right">
                            <button type="submit" class="btn btn-primary me-auto"><img src="~/images/icons/check.png" style="height:15px; margin-bottom:3px" /> Save</button>
                            <button type="button" class="btn btn-danger me-auto" onclick="clearForm()"><img src="~/images/icons/circular.png" style="height:15px; margin-bottom:3px" /> Clear</button>
                        </div>
                        <input type="hidden" value="@Model?.ImagePath" name="ImagePath" />
                        <input type="hidden" value="/Admin/ValueHome/Create" id="URL" />
                        <input type="hidden" value="@Model?.Id" name="Id" />
                    </div>
                </div>
            </div>
            <div class="col-md-4 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="form-group">
                                <label asp-for="ImagePath" style="color:#00f">Upload Image (200 * 200 H)</label>
                                <input type="file" asp-for="Image" class="file-upload-default" />
                                <span asp-validation-for="Image" style="font-size:.9em; color:red"></span>
                            </div>
                        </div>
                        @await Html.PartialAsync("_PreviewImage", Model?.ImagePath)
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts{
    <script src="~/js/npm_axios_dist_axios.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/customscript/shared.js"></script>
    <script>
        function clearForm() {
            document.getElementById("formAdmin").reset();
            var imagePreview = document.getElementById("imagePreview");
            imagePreview.src = "";
        }
    </script>
}  