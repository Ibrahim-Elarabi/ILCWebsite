@model List<ILC.BL.Models.Admin.HomeSection.Titles.TitleVM>
@using Microsoft.Extensions.Localization
@using ILCWebsite.Models.Resources
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "List";
} 
<!-- Custom styles for this page -->
<link href="vendor/datatables/dataTables.bootstrap4.min.css" rel="stylesheet">
<div class="content-wrapper">
    <h4 class="fancy-title">Sections Title Table</h4>
    <div class="container-fluid">
        <!-- DataTales Example -->
        <div class="card shadow mb-4"> 
            <div class="card-body">
                <div class="table-responsive"> 
                    <table class="table table-bordered table-sm" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Section Name</th>
                                <th>Arabic title</th>
                                <th>English title</th>
                                <th>Arabic description</th>
                                <th>English description</th>
                                <th>Actions</th>
                            </tr>
                        </thead> 
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center">@item?.Id</td>
                                     <td>@item?.SectionName</td>
                                     <td>@item?.TitleAr</td>
                                    <td>@item?.TitleEn</td>
                                    <td>@item?.DescriptionAr</td>
                                    <td>@item?.DescriptionEn</td>
                                    <td style="min-width:120px" class="text-center">
                                        <a class="btn btn-primary me-auto" href="/Admin/Title/Edit/@item?.Id"><img src="~/images/icons/edit.png" alt="edit" style="height:15px; margin-bottom:3px" /> Edit</a>
                                     </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/npm_axios_dist_axios.min.js"></script> 
} 

