@model ILC.BL.Models.Admin.HomeSection.Titles.EditTitleVM
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit";
}
<div class="content-wrapper">
    <h4 class="fancy-title">Edit Title</h4>
    <div class="page-header text-right mb-2">
        <a class="btn btn-primary" asp-controller="Title" asp-action="index">
            <img src="~/images/icons/left-arrow.png" alt="edit" style="height:15px; margin-bottom:3px" /> Back to list
        </a>
    </div>
    <form id="formAdmin" class="forms-sample">
        <div class="row">
            <div class="col-md-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="SectionName">SectionName : </label>
                                    <input type="text" asp-for="SectionName" class="form-control" disabled />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="TitleEn">Title En : </label>
                                    <input type="text" asp-for="TitleEn" class="form-control" placeholder="Title En" />
                                    <span asp-validation-for="TitleEn" style="font-size:.9em; color:red"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="TitleAr">Title Ar : </label>
                                    <input type="text" asp-for="TitleAr" class="form-control" placeholder="Title Ar" />
                                    <span asp-validation-for="TitleAr" style="font-size:.9em; color:red"></span>
                                </div>
                            </div> 
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="DescriptionEn">Description En : </label>
                                    <textarea type="text" asp-for="DescriptionEn" class="form-control" id="DescriptionEn"
                                              placeholder="Description En" rows="5"></textarea>
                                    <span asp-validation-for="DescriptionEn" style="font-size:.9em; color:red"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="DescriptionAr">Description Ar : </label>
                                    <textarea type="text" asp-for="DescriptionAr" class="form-control" id="DescriptionAr"
                                              placeholder="Description Ar" rows="5"></textarea>
                                    <span asp-validation-for="DescriptionAr" style="font-size:.9em; color:red"></span>
                                </div>
                            </div>
                        </div> 
                        <div class="text-right">
                            <button type="submit" class="btn btn-primary me-auto"><img src="~/images/icons/check.png" alt="edit" style="height:15px; margin-bottom:3px" /> Save</button>
                            <button type="button" class="btn btn-danger me-auto" onclick="clearForm()"><img src="~/images/icons/circular.png" alt="edit" style="height:15px; margin-bottom:3px" /> Reset</button>
                        </div> 
                        <input type="hidden" value="/Admin/Title/Edit" id="URL" />
                        <input type="hidden" value="@Model?.Id" name="Id" />
                    </div>
                </div>
            </div>
         </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/npm_axios_dist_axios.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/customscript/shared.js"></script>
    <script>
        function clearForm() {
            document.getElementById("formAdmin").reset(); 
        }
    </script>
}  